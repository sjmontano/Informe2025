---
import "../styles/animaciones.css";

export interface Props {
  scroll?: boolean;
}

const { scroll = true } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Favicon -->
    <link rel="icon" href="/logo.ico" />

    <title>Informe de Gestión 2025</title>

    <!-- Lato — Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- Preload del primer fondo (LCP) -->
    <link
      rel="preload"
      as="image"
      href="/resources/fondos/fondo-seccion-01-sm.webp"
      media="(max-width: 640px)"
    />
    <link
      rel="preload"
      as="image"
      href="/resources/fondos/fondo-seccion-01.webp"
      media="(min-width: 641px)"
    />

    <!-- Preload de Discordia Bold (títulos y cifras) -->
    <link
      rel="preload"
      as="font"
      href="/fonts/Discordia-Bold.woff2"
      crossorigin
    />
  </head>
  <body class:list={{ "pagina-fija": !scroll }}>
    <div class="scene-wrapper">
      <slot />
    </div>
  </body>

  <script>
    const obsAnim = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const root = entry.target as HTMLElement;
          const stagger = parseInt(root.dataset.animStagger || "0", 10);
          const items = root.querySelectorAll<HTMLElement>("[data-anim-item]");
          items.forEach((item, i) => {
            item.style.setProperty("--anim-delay", (i + 1) * stagger + "ms");
          });
          root.classList.add("activo");
          obsAnim.unobserve(root);
        });
      },
      { threshold: 0.1, rootMargin: "100px" },
    );

    document
      .querySelectorAll<HTMLElement>(".anim-entrada")
      .forEach((el) => obsAnim.observe(el));
  </script>
</html>

<style is:global>
  /* Discordia — fuente de títulos (Aquelarre Laboratorio de Diseño Feminista) */
  @font-face {
    font-family: "Discordia";
    src:
      url("/fonts/Discordia-Regular.woff2") format("woff2"),
      url("/fonts/Discordia-Regular.woff") format("woff");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Discordia";
    src: url("/fonts/Discordia-Bold.woff2") format("woff2");
    font-weight: 700;
    font-style: bold;
    font-display: swap;
  }

  @font-face {
    font-family: "Discordia";
    src: url("/fonts/Discordia-Italic.woff2") format("woff2");
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: "Discordia";
    src: url("/fonts/Discordia-BoldItalic.woff2") format("woff2");
    font-weight: 700;
    font-style: italic;
    font-display: swap;
  }

  /* =========================================
     DESIGN TOKENS — Marea Feminista
     Fuente: DESIGN.md
     ========================================= */
  :root {
    /* Fondos */
    --arena: #f4c454;
    --oceano: #148979;

    /* Textos */
    --azul-noche: #1b174b;
    --naranja-madera: #d36a3b;
    --blanco: #f0f4ff;
    --petroleo: #00484c;

    /* Botones */
    --rosa: #f5b2d1;
    --coral: #ef7e7b;
    --salmon: #f7b5a9;
    --turquesa: #14efb0;

    /* Componentes */
    --circulo-fondo: #1f1a3e;
    --circulo-texto: #fde070;
    --mapa-base: #28275b;
    --mapa-seleccionado: #39b490;

    /* Tipografía */
    --font-discordia: "Discordia", serif;
    --font-lato: "Lato", sans-serif;

    /* Espaciado */
    --espacio-xs: 4px;
    --espacio-sm: 8px;
    --espacio-md: 16px;
    --espacio-lg: 24px;
    --espacio-xl: 32px;
    --espacio-2xl: 48px;
    --espacio-3xl: 64px;
    --espacio-4xl: 96px;

    /* Altura de una escena.
       Multi-sección: ratio 16:9 (cómodo para scroll).
       Single-sección (body.pagina-fija): llena la pantalla completa. */
    --alto: calc(100vw * 0.5625);
  }

  /* Reset base */
  html,
  body {
    margin: 0;
    width: 100%;
    font-family: var(--font-lato);
    background-color: transparent;
    color: var(--azul-noche);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Página de 1 sección: sin scroll, llena la pantalla */
  body.pagina-fija {
    --alto: 100dvh;
    overflow: hidden;
    height: 100%;
  }

  body.pagina-fija .scene-wrapper {
    min-height: auto;
    height: var(--alto);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  .scene-wrapper {
    position: relative;
    min-height: var(--alto);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>
