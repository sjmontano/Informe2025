---
/**
 * ESCENA 4 · CUENTAS CLARAS
 *
 * Visualización de ingresos y gastos 2025 con barras de progreso.
 */
import BotonVolver from "./BotonVolver.astro";
import FlechaNav from "./FlechaNav.astro";

const dataIngresos = [
  {
    text: "SALDOS DE PROYECTOS A DIC-31-2024",
    value: "$ 10.165.693.195",
    percentage: 44.14,
  },
  { text: "DONANTES EUROPEOS", value: "$ 4.646.551.991", percentage: 20.18 },
  {
    text: "DONANTES NORTEAMERICANOS",
    value: "$ 6.330.098.770",
    percentage: 27.49,
  },
  { text: "FISCAL SPONSOR", value: "$ 542.160.000", percentage: 2.35 },
  { text: "OTROS", value: "$ 1.346.493.843", percentage: 5.85 },
  { text: "Total", value: "$ 23.030.997.799", percentage: 100 },
];

const dataGastos = [
  { text: "APOYO A ORGANIZACIONES", value: "$ 5.590.308.439", percentage: 56 },
  { text: "GASTOS PROGRAMÁTICOS", value: "$ 658.665.474", percentage: 7 },
  { text: "DESARROLLO INSTITUCIONAL", value: "$ 715.296.441", percentage: 7 },
  { text: "GASTOS ADMINISTRATIVOS", value: "$ 1.099.009.043", percentage: 11 },
  { text: "INVESTIGACIÓN", value: "$ 421.112.446", percentage: 4 },
  { text: "FISCAL SPONSOR", value: "$ 545.918.110", percentage: 6 },
  {
    text: "PROYECTOS REGIONALES LATINOAMERICANOS",
    value: "$ 894.102.717",
    percentage: 9,
  },
  { text: "Total", value: "$ 9.924.412.670", percentage: 100 },
];
---

<section class="cuentas">
  <BotonVolver href="/#navegacion" variante="circulo" bottom={4} left={4} z={3} />
  <div class="cuentas__flecha--prev">
      <FlechaNav
        direccion="izquierda"
        class="cuentas__flecha"
      />
    </div>
      
    <div class="cuentas__flecha--next">
      <FlechaNav
        direccion="derecha"
        class="cuentas__flecha"
      />
    </div>

  <div class="cuentas__contenido" data-idx="0">
    

    <div class="cuentas__columna cuentas__columna--ingresos" data-panel="0">
      <span class="cuentas__subtitulo ac-blanco" data-read
        >En mareas cambiantes, cuentas claras:</span
      >

      <h2 class="cuentas__titulo ac-blanco" data-read>Ingresos 2025</h2>

      <ul class="cuentas__lista">
        {
          dataIngresos
            .filter((dato) => dato.text !== "Total")
            .map((dato) => (
              <li>
                <div class="progress" data-anim-item data-read>
                  <span class="progress__titulo noche-claro">{dato.text}</span>

                  <div class="progress__contenedor">
                    <div
                      class="progress__barra"
                      data-target={dato.percentage}
                    />

                    <span class="progress__valor noche-claro">{dato.value}</span>
                    <span class="progress__porcentaje noche-claro">{dato.percentage}%</span>
                  </div>
                </div>
              </li>
            ))
        }

        <li class="cuentas__total noche-claro" data-read>
          <span>{dataIngresos[dataIngresos.length - 1].text}</span>
          <span class="cuentas__valor"
            >{dataIngresos[dataIngresos.length - 1].value}</span
          >
        </li>
      </ul>
    </div>

    <div class="cuentas__columna cuentas__columna--gastos" data-panel="1">
      <span class="cuentas__subtitulo ac-blanco" data-read
        >En mareas cambiantes, cuentas claras:</span
      >

      <h2 class="cuentas__titulo ac-blanco" data-read>Gastos 2025</h2>

      <ul class="cuentas__lista">
        {
          dataGastos
            .filter((dato) => dato.text !== "Total")
            .map((dato) => (
              <li>
                <div class="progress" data-anim-item data-read>
                  <span class="progress__titulo noche-claro">{dato.text}</span>

                  <div class="progress__contenedor">
                    <div
                      class="progress__barra"
                      data-target={dato.percentage}
                    />

                    <span class="progress__valor noche-claro">{dato.value}</span>
                    <span class="progress__porcentaje noche-claro">{dato.percentage}%</span>
                  </div>
                </div>
              </li>
            ))
        }

        <li class="cuentas__total noche-claro" data-read>
          <span>{dataGastos[dataGastos.length - 1].text}</span>
          <span class="cuentas__valor"
            >{dataGastos[dataGastos.length - 1].value}</span
          >
        </li>
      </ul>
    </div>
  </div>
</section>

<style>

  .cuentas__flecha--next{
    display: none;
  }
  .cuentas {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .cuentas__contenido {
    position: absolute;
    top: 14vh;
    width: 100%;
    padding: 0 12%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 30%;
  }

  .cuentas__columna {
    width: 35%;
    display: flex;
    flex-direction: column;
  }

  .cuentas__nav {
    display: none;
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: space-between;
    padding: 0 4%;
    pointer-events: none;
  }

  .cuentas__flecha {
    pointer-events: auto;
  }

 

  .cuentas__subtitulo {
    font-family: var(--font-lato);
    font-size: 2.2vh;
    color: var(--azul-noche);
    margin: 0;
  }

  .cuentas__titulo {
    font-family: var(--font-discordia);
    font-size: 4.6vh;
    font-weight: 700;
    color: var(--azul-noche);
    margin-top: 0vw;
    margin-bottom: 4vh;
  }

  .cuentas__lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2vh;
    padding: 0;
    margin: 0;
  }

  .cuentas__total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-discordia);
    font-size: 1.2vw;
    font-weight: 700;
    color: var(--blanco);
  }

  .cuentas__valor {
    text-align: right;
  }

  /* ─── Progress Bar ─── */

  .progress__titulo {
    font-size: 1vw;
    color: var(--blanco);
    z-index: 2;
  }

  .progress__valor {
    font-size: 1vw;
    position: absolute;
    color: var(--blanco);
    margin-left: 1.4vw;
  }

  .progress__porcentaje {
    font-size: 1vw;
    color: var(--blanco);
    margin-right: 1vw;
  }

  .progress {
    width: 100%;
    flex-direction: column;
    display: flex;
    justify-content: center;
    background-color: transparent;
    overflow: hidden;
    z-index: 1;
    gap: 1vh;
  }

  .progress__contenedor {
    display: flex;
    align-items: center;
    width: 100%;
    background-color: var(--azul-noche);
    overflow: hidden;
    height: 3.3vh;
    z-index: 1;
    justify-content: space-between;
  }

  .progress__barra {
    height: 100%;
    background-color: var(--oceano);
    width: 0%;
    transition: width 2s ease;
  }

   @media (max-width: 640px) {

    .cuentas__flecha--next{
    display: flex;
  }
    .cuentas__contenido {
      flex-direction: column;
      align-items: center;
      gap: 6vw;
    }

    .cuentas__nav {
      display: flex;
      position: absolute;
      top: 22vh;
      pointer-events: visible;
    }

    .cuentas__flecha {
      pointer-events: auto;
    }

    .cuentas__columna {
      width: 90%;
    }

    .cuentas__columna--gastos {
      display: none;
    }

     
    .cuentas__subtitulo{
      font-size: 1.2vh;
    }
    .cuentas__titulo{
      font-size: 2.6vh;
    }
    .progress__valor{
      font-size: 1.4vh;
    }

    .progress__porcentaje{
      font-size: 1.4vh;
    }
    .progress__titulo{
      font-size: 1.4vh;
    }
    .cuentas__total{
      font-size: 1.6vh;
    }

    .cuentas__flecha--next{
      margin-left: 85vw;
      position: absolute;
      top: 40vh;        
      z-index: 10;
    }

    .cuentas__flecha--prev{
      margin-right: 85vw;
      position: absolute;
      top: 40vh;
      z-index: 10;
    }
  }
</style>

<script>
  const bars = document.querySelectorAll(".progress__barra");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const bar = entry.target as HTMLElement;
        const target = bar.getAttribute("data-target");

        if (entry.isIntersecting) {
          bar.style.transition = "width 1.5s ease";
          bar.style.width = `${target}%`;
        }
      });
    },
    { threshold: 0.5 },
  );

  bars.forEach((bar) => observer.observe(bar));

  const contenido = document.querySelector<HTMLElement>(".cuentas__contenido");
  const botonAnterior = document.querySelector(".cuentas__flecha--prev");
  const botonSiguiente = document.querySelector(".cuentas__flecha--next");
  
    botonAnterior.style.setProperty("display", "none", "important");

  

  

  
  const ingresosContent = document.querySelector(".cuentas__columna--ingresos");
  const gastosContent = document.querySelector(".cuentas__columna--gastos");

  

  botonSiguiente.addEventListener("click", () => {
    ingresosContent.style.setProperty("display", "none", "important");
    gastosContent.style.setProperty("display", "flex", "important");
    botonAnterior.style.setProperty("display", "flex", "important");
    botonSiguiente.style.setProperty("display", "none", "important");
  });


  botonAnterior.addEventListener("click", () => {
    ingresosContent.style.setProperty("display", "flex", "important");
    gastosContent.style.setProperty("display", "none", "important");
    botonAnterior.style.setProperty("display", "none", "important");
    botonSiguiente.style.setProperty("display", "flex", "important");
  });


</script>
