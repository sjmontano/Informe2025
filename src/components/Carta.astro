---
/**
 * ESCENA 1 · CARTA
 *
 * Texto poético introductorio + cifras animadas "Apoyamos".
 * Posicionado con calc() relativo a --alto definido en Layout.
 */
---

<section class="carta">
  <div class="carta__texto anim-entrada anim-entrada--fade" data-anim-stagger="350">
    <p data-anim-item>
      Desde la orilla del mar observamos la inmensidad que el horizonte nos
      regala y nos invita a alcanzar.
    </p>

    <p data-anim-item>
      Ampliamos la mirada y nos dejamos guiar por la diversidad, el compromiso y
      la esperanza de cada persona que acompañó esta travesía. Aun frente a
      vientos cambiantes y adversos, 2025 fue un año en el que no perdimos el
      rumbo y en el que cada iniciativa se convirtió en un faro que iluminó
      caminos.
    </p>

    <p data-anim-item>
      Con la brújula apuntando a nuestro Sur y el horizonte claro, supimos
      orientar esfuerzos para apañarnos en un espacio pensado para todas, todos
      y todes.
    </p>

    <p data-anim-item>
      Seguimos avanzando con la certeza que cada acción deja una huella firme, y
      por eso extendemos la invitación a continuar este viaje, a reencontrarse
      con un mar que nunca deja de sorprendernos.
    </p>
  </div>

  <div class="carta__estadisticas anim-entrada anim-entrada--blur" data-anim-stagger="250">
    <p class="carta__intro noche-claro" data-anim-item>
      El crecimiento fue constante,<br />como el pulso del mar.
    </p>
    <p class="carta__titulo noche-claro" data-anim-item>Apoyamos:</p>
    <div class="carta__cifras" data-anim-item>
      <div class="carta__cifra">
        <span class="carta__numero" data-target="374">0</span>
        <span class="carta__etiqueta">Organizaciones</span>
      </div>
      <div class="carta__cifra">
        <span class="carta__numero" data-target="557">0</span>
        <span class="carta__etiqueta">Iniciativas</span>
      </div>
      <div class="carta__cifra">
        <span class="carta__numero" data-target="29">0</span>
        <span class="carta__etiqueta">Departamentos</span>
      </div>
    </div>
  </div>
</section>

<style>
  .carta {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .carta__texto {
    position: absolute;
    top: calc(var(--alto) * 25.4 / 100);
    left: 18%;
    width: 30%;
    color: var(--azul-noche);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .carta__texto p {
    font-family: var(--font-lato);
    font-weight: 500;
    font-size: calc(var(--alto) * 2.34 / 100);
    line-height: 1.1;
    margin: 0;
  }

  .carta__estadisticas {
    position: absolute;
    top: calc(var(--alto) * 29 / 100);
    right: 12%;
    width: 30%;
  }

  .carta__intro {
    font-family: var(--font-lato);
    font-size: calc(var(--alto) * 2.1 / 100);
    color: var(--blanco);
    margin: 0 0 var(--espacio-sm);
    line-height: 1.3;
  }

  .carta__titulo {
    font-family: var(--font-lato);
    font-size: calc(var(--alto) * 2.1 / 100);
    font-weight: 400;
    color: var(--blanco);
    margin: 0 0 var(--espacio-md * 2);
  }

  .carta__cifras {
    display: flex;
    justify-content: space-between;
    gap: var(--espacio-md);
  }

  .carta__cifra {
    background-color: rgb(from var(--rosa) r g b / 0.8);
    border-radius: var(--espacio-sm);
    text-align: center;
    flex: 1;
    padding: var(--espacio-md) var(--espacio-sm);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .carta__numero {
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 4.5 / 100);
    font-weight: 700;
    color: var(--azul-noche);
    line-height: 1;
  }

  .carta__etiqueta {
    font-family: var(--font-lato);
    font-size: calc(var(--alto) * 2.1 / 100);
    font-weight: 500;
    color: var(--azul-noche);
    margin-top: var(--espacio-xs / 2);
  }
</style>

<script>
  function animarCifras(
    entries: IntersectionObserverEntry[],
    observer: IntersectionObserver,
  ) {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;

      const numeros = entry.target.querySelectorAll(".carta__numero");
      numeros.forEach((el) => {
        const target = Number(el.getAttribute("data-target") ?? 0);
        const paso = target / 200;
        let actual = 0;

        const avanzar = () => {
          actual += paso;
          if (actual < target) {
            el.textContent = Math.ceil(actual).toString();
            requestAnimationFrame(avanzar);
          } else {
            el.textContent = target.toString();
          }
        };

        avanzar();
      });

      observer.unobserve(entry.target);
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    const seccion = document.querySelector(".carta__estadisticas");
    if (!seccion) return;

    const observer = new IntersectionObserver(animarCifras, { threshold: 0.5 });
    observer.observe(seccion);
  });
</script>
