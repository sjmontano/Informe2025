---
/**
 * ESCENA 8 · TALLERES
 *
 * Sección de Talleres.
 */
import BotonVolver from "./BotonVolver.astro";
---

<section
  class="talleres anim-entrada anim-entrada--fade"
  data-anim-stagger="200"
>
  <BotonVolver href="/" texto="Inicio" top={3} right={6} z={3} />

  <h1 class="talleres__titulo" data-anim-item>Talleres</h1>
</section>

<style>
  .talleres {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .talleres__titulo {
    position: absolute;
    top: calc(var(--alto) * 14 / 100);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 5.4 / 100);
    font-weight: 700;
    color: var(--azul-noche);
    margin: 0;
  }
</style>
