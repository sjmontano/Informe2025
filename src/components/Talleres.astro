---
// src/components/CardCarousel.astro
import BotonVolver from "./BotonVolver.astro";
import FlechaNav from "./FlechaNav.astro";

const talleres = [
  // Asegúrate de añadir la propiedad 'fecha' a cada objeto taller
  {
    titulo:
      "Activismos feministas amplios y diversos para generar comunidad 26, 27 Y 28 de marzo",
    imagen:
      "/resources/fotografias/real/1. Activismos feministas amplios y diversos para generar comunidad.JPG",
    fecha: "1 y 2 de Febrero",
  },
  {
    titulo: "Otros Mundos son posibles 25 y 26 de abril",
    imagen:
      "/resources/fotografias/real/2. OTROS MUNDOS SON POSIBLES.JPG",
    fecha: "15 y 16 de Febrero",
  },
  {
    titulo:
      "Acuerpando Nuestras Luchas Para Defender Nuestros Derechos 1 29 y 30 de mayo",
    imagen:
      "/resources/fotografias/real/3. Acuerpando Nuestras Luchas Para Defender Nuestros Derechos.JPG",
    fecha: "26 y 28 de febrero",
  },
  {
    titulo: "Encuentro regional LATAM OTRT 25, 26 y 27 de junio",
    imagen: "/resources/fotografias/real/4. Encuentro regional LATAM OTRT. JPG",
    fecha: "14 y 15 de marzo",
  },
  {
    titulo: "Acuerpando Nuestras Luchas Para Defender Nuestros Derechos 2 10 y 11 de julio",
    imagen:
      "/resources/fotografias/real/5. Acuerpando Nuestras Luchas Para Defender Nuestros Derechos .JPG",
    fecha: "18 y 19 de abril",
  },
  {
    titulo:
      "Construyendo Autonomías para Tejer Vida Digna 1 24 y 25 de julio",
    imagen:
      "/resources/fotografias/real/6. Construyendo Autonomías para Tejer Vida Digna 1.JPG",
    fecha: "30 y 31 de mayo",
  },
  {
    titulo: "Construyendo Autonomías para Tejer Vida Digna 2 14 y 15 de agosto",
    imagen:
      "/resources/fotografias/real/7. Construyendo Autonomías para Tejer Vida Digna 2.JPG",
    fecha: "13 y 14 de junio",
  },
  {
    titulo: "Hackearlo todo 28 y 29 de agosto",
    imagen:
      "/resources/fotografias/real/8. Hackearlo todo.JPG",
    fecha: "22 y 23 de agosto",
  },
  {
    titulo:
      "Encuentro LB 16 y 17 de octubre",
    imagen:
      "/resources/fotografias/real/9. Encuentro LB.JPG",
    fecha: "Septiembre 12 y 13",
  },
];

interface Props {
  title?: string;
  subtitle?: string;
}
const { title = "Talleres" } = Astro.props;
const carouselId = `carousel-${crypto.randomUUID().slice(0, 8)}`;
---

<section class="card-carousel-section" id={carouselId}>
  <BotonVolver href="/#navegacion" variante="circulo" bottom={4} left={1} z={3} />

  <div class="titulos">
    <div class="centrado">
    <span class="talleres-title ac-blanco" data-read>{title}</span>
      <span class="talleres-encuentros ac-blanco" data-read>9 talleres y encuentros</span>

    </div>
    <div class="subtitulos">
      <span class="talleres-subtitle" lang="es" data-read>La playa nos enseña que la riqueza del ecosistema no está en <br>
          la uniformidad, sino en la diversidad que late en cada rincón:<br>
          en las mareas que van y vienen, en las especies que conviven,<br>
          en los colores y formas que construyen un paisaje vivo y en<br>
          constante transformación. Por esto, compartimos espacios<br>
          colectivos para aprender juntes.

        </span
      >
      <br />

    </div>

  </div>

  <div class="card-carousel-container">
    <FlechaNav
      direccion="izquierda"
      class="prev-button previo"
    />

    <div class="card-carousel-wrapper">
      <div class="card-carousel">
        {
          talleres.map((taller, index) => (
            <div class="taller-card" data-index={index}>
              <div class="taller-imagen">
                {taller.imagen ? (
                  <img class="marco" src="/resources/contenedor/marcoRosa.webp" alt="" loading="lazy" />
                  <img class="taller-imagen-img" src={taller.imagen} alt={taller.titulo} loading="lazy" data-lighterbox="talleres" />
                ) : (
                  <span class="imagen-placeholder" aria-hidden="true" />
                )}
              </div>
              <div class="contenedor-taller-titulo">
                <div class="contenedor-taller-numeracion">
                  <h3 class="taller-numeracion">{index + 1}.</h3>
                </div>
                <h3 class="taller-titulo" data-read>{taller.titulo}</h3>

              </div>

            </div>
          ))
        }
      </div>
    </div>
    {/* Indicadores Puntos */}
    <div class="card-indicadores">
      {
        talleres.map((_, i) => (
          <button
            class={`card-indicador${i === 0 ? " active" : ""}`}
            data-index={i}
            aria-label={`Ir al slide ${i + 1}`}
          />
        ))
      }
    </div>

    <FlechaNav
      direccion="derecha"
      class="next-button"
    />
  </div>
</section>

<style>



.contenedor-taller-numeracion{
  position: absolute;
  background-color: #161040;
  z-index: 3;
  border-radius: 50%;
  width: 5.5vh;
  height: 5.5vh;
  align-items: center;
  justify-content: center;
  display: flex;
  margin-right: 27%;
  margin-top: 1vh;
  font-size: 3.5vh;
  font-family: var(--font-discordia);
  color: var(--arena);
}
  .previo{
    width: 6vw !important;


  }
  body {
    font-family: sans-serif;
    /* Quita el background del body si lo defines a nivel de página/layout */
    /* background-color: #e0e8d5; */
    /* Quita display flex y otros estilos del body si los manejas en el layout general */
    margin: 0;
  }
  .card-carousel-section {
    justify-self: center;
    display: flex;
    position: absolute;
    flex-direction: column;

    width: 90%;
    height: calc(var(--alto) * 0.9);
    z-index: 2;
    top: 2.1vw;
    align-items: center;
  }

  .talleres-title {

    margin: 0;
    font-size: 5vh;
    font-family: var(--font-discordia);
    color: #161040;
    font-weight: 700;
    display: flex;
    justify-content: center;
    height: 7vh;
  }

  .card-carousel-container {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-carousel-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .card-carousel {
    display: flex;
    transition: transform 0.5s ease-in-out;
    gap: 1%; /* Aumentamos el gap aquí */
    flex-wrap: nowrap;
  }

  .taller-card {
    width: calc(98% / 3);
    box-sizing: border-box;
    background-color: transparent;
    border-radius: calc(var(--alto) * 0.2 / 100);
    text-align: center;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease-in-out;
    flex-shrink: 0;
  }

  /** .taller-card:hover {
    background-color: #f7b731;
    transform: scale(1.01);
  }*/

  .taller-imagen {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    height: 38vh;
  }
  .contenedor-taller-titulo{
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: self-start;
  }

  .taller-imagen-img {
    width: 77%;
    height: 23vh;
    margin: 0.4vw 1vw 1vw 0.3vw;
    border-radius: 1vw;
  }
  .marco{
    width: 26vw;
    position: absolute;
    z-index: -1;
    height: 38vh;
  }
  .centrado{
    width: 50%;
  }

  .imagen-placeholder {
    display: block;
    width: calc(var(--alto) * 0.45);
    height: calc(var(--alto) * 1 / 100);
    background-color: rgba(0, 0, 0, 0.1);
  }
  .titulos {

    display: flex;
    width: 90%;
    margin-bottom: 3vh;
    margin-top: 11vh;


  }

  .taller-titulo {
    width: 80%;
    font-size: 1.1vw;
    color: #161040;
    background-color: #ff8079;
    border-radius: 2px;
    margin-top: (var(--alto) * 0.046 / 100);
    padding: calc(var(--alto) * 0.02);
    padding-left: calc(var(--alto) * 0.03);
    border-radius: 1vw;
    justify-self: center;
    margin:0;
  }

  .taller-fecha {
    width: 100%;
    text-align: right;
    padding-right: calc(var(--alto) * 0.046 / 100);
    font-size: 1.2vw;
    color: #333;
    font-weight: bold;
    margin-top: calc(var(--alto) * 0.3 / 100);
  }

  .talleres-subtitle {
    display: flex;
    flex-direction: column;
    font-size: 2vh;
    color: #161040;
    margin-left: 4vw;
  }
  .talleres-encuentros {
    display: flex; /* Permite que el contenido interno de .talleres-encuentros se organice con flexbox */
    flex-direction: end;
    font-size: 2.5vh;
    color: #161040;
    width: 100%;
    justify-content: center;
  }

  .nav-button {
    background-color: transparent;
    border: none;
    color: #f7b731;
    font-size: calc(var(--alto) * 0.18 * var(--zoom-letra, 1));
    cursor: pointer;
    padding: 1%;
    z-index: 2;
    border-radius: 70%;
    line-height: 2;
    transition:
      transform 0.2s ease,
      opacity 0.3s ease;
  }

  .nav-button:hover {
    transform: scale(1.1);
    visibility: visible !important;
  }

  .nav-button:disabled {
    opacity: 0.7;
    cursor: default;
    transform: scale(1);
  }

  .card-indicadores {
    top: calc(var(--alto) * 3.3 / 100);
    position: absolute;
    display: flex;
    gap: calc(var(--alto) * 0.06 / 100);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
  }

  .card-indicador {
    width: calc(var(--alto) * 0.09 / 100);
    height: calc(var(--alto) * 0.09 / 100);
    border-radius: 50%;
    background: #8b8b8b;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .card-indicador.active {
    background: #f7b731;
  }

  .subtitulos{
    width: 50%;
  }

  @media (max-width: 640px) {


    .card-carousel-section{
    height: 96vh;
}

    .taller-card{
      width: calc(98% / 1);
      margin-top: 5vh;
    }
    .flecha-nav {
      width: 5vh;
      height: 5vh;
    }
    .contenedor-taller-titulo {
    margin-top: -6vh;
  }
    .card-carousel-container {
        top: 35vh;
    }

    .titulos{
        display: flex;
        width: 90%;
        margin-top: 0;
        position: absolute;
        justify-content: center;
        flex-direction: column;
        align-items: center;
    }

    .talleres-encuentros {
    font-size: 1.4vh;
    font-weight: bold;
}

    .subtitulos {
        width: 29vh;
        margin-top: 7vh;
    }

    .talleres-title {
    font-size: 3.2vh;
    height: 4.5vh;
    margin-top: 3.5vh;
    
}

.talleres-subtitle {
    font-size: 1.6vh;
    margin-left: 7vw;
    margin-top: 1.5vh;
}

.talleres-subtitle br{
  display: none;
}

.marco {
    width: 58vw;
    height: 25vh;
}


.taller-imagen-img{
    width: 42vw;
    margin: 0.4vw 1.5vw 3vw 0.1vw;
    border-radius: 1vw;
    height: 14vh;
}

.contenedor-taller-numeracion {
    width: 3.5vh;
    height: 3.5vh;
    margin-right: 80%;
    margin-top: 0.5vh;
    font-size: 1.5vh;
}

  .taller-titulo{
    font-size: 1vh;
    border-radius: 2vw;
    
}
.fondo-movimiento__texto br{
    display: none;

  }
  .centrado{
    margin-top: 5vh;
    margin-left: 12vh;
  }

  }


  /**

  */
</style>

<script define:vars={{ carouselId }}>
  const carouselElement = document.getElementById(carouselId);

  if (carouselElement) {
    const cardCarousel = carouselElement.querySelector(".card-carousel");
    const prevButton = carouselElement.querySelector(".prev-button");
    const nextButton = carouselElement.querySelector(".next-button");
    const tallerCards = carouselElement.querySelectorAll(".taller-card");

    let currentTallerIndex = 0;
    let cardsToShow = 3;
    const gap = 20;
    let maxIndex = 0;
    let hoverInterval = null;

    function updateCardsToShowAndRecalculate() {
      if (!tallerCards.length) return;

      const screenWidth = window.innerWidth;
      const oldCardsToShow = cardsToShow;

      if (screenWidth <= 480) {
        cardsToShow = 1;
      } else if (screenWidth <= 768) {
        cardsToShow = 2;
      } else {
        cardsToShow = 3;
      }

      maxIndex = Math.max(0, Math.ceil(tallerCards.length - cardsToShow));

      if (currentTallerIndex > maxIndex || oldCardsToShow !== cardsToShow) {
        currentTallerIndex = Math.min(currentTallerIndex, maxIndex);
        updateCarouselPosition(false);
      } else {
        updateCarouselPosition(false);
      }

      updateButtonStates();
    }

    function updateActiveIndicator() {
      const indicadores = carouselElement.querySelectorAll(".card-indicador");
      indicadores.forEach((btn, i) => {
        btn.classList.toggle("active", i === currentTallerIndex);
      });
    }

    function updateCarouselPosition(animate = true) {
      const reduceMotion =
        document.documentElement.classList.contains("modo-sin-movimiento");
      const shouldAnimate = animate && !reduceMotion;
      const screenWidth = window.innerWidth;

      if (screenWidth <= 447) {
        if (!tallerCards.length || !cardCarousel) return;

        const cardWidth = tallerCards[0].getBoundingClientRect().width;
        const totalWidthPerCard = cardWidth + cardWidth * 0.01;
        console.log("si");
        const translateX = currentTallerIndex * totalWidthPerCard;
        cardCarousel.style.transition = shouldAnimate
          ? "transform 1s ease-in-out"
          : "none";
        cardCarousel.style.transform = `translateX(-${translateX}px)`;
      } else {
        if (!tallerCards.length || !cardCarousel) return;

        const cardWidth = tallerCards[0].getBoundingClientRect().width;
        const totalWidthPerCard = cardWidth + cardWidth * 0.03;

        const translateX = currentTallerIndex * totalWidthPerCard;
        cardCarousel.style.transition = shouldAnimate
          ? "transform 1s ease-in-out"
          : "none";
        cardCarousel.style.transform = `translateX(-${translateX}px)`;
      }

      updateActiveIndicator();
    }

    function updateButtonStates() {
      const canScroll = tallerCards.length > cardsToShow;

      prevButton.disabled = currentTallerIndex === 0;
      nextButton.disabled = currentTallerIndex >= maxIndex;

      prevButton.style.visibility = canScroll ? "visible" : "hidden";
      nextButton.style.visibility = canScroll ? "visible" : "hidden";
    }

    function autoScroll(direction) {
      hoverInterval = setInterval(() => {
        const newIndex = Math.max(
          0,
          Math.min(maxIndex, currentTallerIndex + direction * cardsToShow)
        );
        if (newIndex !== currentTallerIndex) {
          currentTallerIndex = newIndex;
          updateCarouselPosition();
          updateButtonStates();
        }
      }, 4000);
    }

    function stopAutoScroll() {
      clearInterval(hoverInterval);
      hoverInterval = null;
    }

    prevButton.addEventListener("click", () => {
      const newIndex = Math.max(0, currentTallerIndex - cardsToShow);
      if (newIndex !== currentTallerIndex) {
        currentTallerIndex = newIndex;
        updateCarouselPosition();
        updateButtonStates();
      }
    });

    nextButton.addEventListener("click", () => {
      const newIndex = Math.min(maxIndex, currentTallerIndex + cardsToShow);
      if (newIndex !== currentTallerIndex) {
        currentTallerIndex = newIndex;
        updateCarouselPosition();
        updateButtonStates();
      }
    });

    prevButton.addEventListener("mouseenter", () => {
      if (document.documentElement.classList.contains("modo-sin-movimiento")) return;
      autoScroll(-1);
    });
    prevButton.addEventListener("mouseleave", stopAutoScroll);
    nextButton.addEventListener("mouseenter", () => {
      if (document.documentElement.classList.contains("modo-sin-movimiento")) return;
      autoScroll(1);
    });
    nextButton.addEventListener("mouseleave", stopAutoScroll);

    // También, agrega el evento click a cada indicador:
    const indicadores = carouselElement.querySelectorAll(".card-indicador");
    indicadores.forEach((btn, i) => {
      btn.addEventListener("click", () => {
        currentTallerIndex = i;
        updateCarouselPosition();
        updateButtonStates();
      });
    });

    window.addEventListener("resize", updateCardsToShowAndRecalculate);

    // --- SWIPE SUPPORT FOR MOBILE ---
    function addSwipeSupport() {
      let startX = 0;
      let isSwiping = false;

      cardCarousel.addEventListener("touchstart", (e) => {
        if (e.touches.length === 1) {
          startX = e.touches[0].clientX;
          isSwiping = true;
        }
      });

      cardCarousel.addEventListener(
        "touchmove",
        (e) => {
          // Prevent scrolling while swiping horizontally
          if (isSwiping) e.preventDefault();
        },
        { passive: false }
      );

      cardCarousel.addEventListener("touchend", (e) => {
        if (!isSwiping) return;
        const endX = e.changedTouches[0].clientX;
        const deltaX = endX - startX;
        const threshold = 50; // px mínimo para considerar swipe

        if (deltaX > threshold && currentTallerIndex > 0) {
          // Hacia la derecha: anterior
          currentTallerIndex = Math.max(0, currentTallerIndex - 1);
          updateCarouselPosition();
          updateButtonStates();
        } else if (deltaX < -threshold && currentTallerIndex < maxIndex) {
          // Hacia la izquierda: siguiente
          currentTallerIndex = Math.min(maxIndex, currentTallerIndex + 1);
          updateCarouselPosition();
          updateButtonStates();
        }
        isSwiping = false;
      });
    }
    // Solo activar swipe en pantallas móviles
    if (window.innerWidth <= 480) {
      addSwipeSupport();
    }
    window.addEventListener("resize", () => {
      if (window.innerWidth <= 480) {
        addSwipeSupport();
      }
    });
    // --- END SWIPE SUPPORT ---

    function initializeCarousel() {
      if (tallerCards.length === 0) {
        prevButton.style.display = "none";
        nextButton.style.display = "none";
        return;
      }
      updateCardsToShowAndRecalculate();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeCarousel);
    } else {
      initializeCarousel();
    }
  } else {
    console.error(`Carousel container with ID "${carouselId}" not found.`);
  }
</script>
