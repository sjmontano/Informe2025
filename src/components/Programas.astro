---
/**
 * ESCENA 9 · PROGRAMAS
 *
 * Mapa interactivo de Colombia + dos bloques de estadísticas:
 * Libertad y Democracia, y Autonomía, Derechos y Sostenibilidad.
 */
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BotonVolver from "./BotonVolver.astro";
import Mapa from "./Mapa.astro";
import FlechaNav from "./FlechaNav.astro";

const svgMap = readFileSync(
  join(process.cwd(), "public", "resources", "mapa", "mapa-colombia.svg"),
  "utf-8",
);
---

<section
  class="programas  "
  data-anim-stagger="200"
>

  
  <div class="navegacionDesktop">
  <BotonVolver href="/#navegacion"   variante="circulo" bottom={12} left={6} z={3} />
  </div>

  
  <div class="navegacionMobile">
  <BotonVolver href="/#navegacion"   variante="circulo" bottom={1} left={1} z={3} />
  </div>


  <h1 class="programas__titulo ac-blanco" data-anim-item data-read>Programas</h1>

  <!-- MAPA INTERACTIVO DE COLOMBIA -->
  <div class="programas__mapa">
    <Mapa svgContent={svgMap} />
  </div>

  <div class="container">

    <!-- BLOQUE 1 · LIBERTAD Y DEMOCRACIA -->
  <article class="programas__bloque programas__bloque--libertad" data-anim-item>
    

    <div class="programas__info">
      <div class="titulo__contenedor">
        <div class="programas__circulo programas__circulo--libertad">
        <img
        src="/resources/escenario/escenario-conchas.webp"
        alt=""
        class="programas__icono"
        width="48"
        height="48"
        loading="lazy"
        />
      </div>

      <h2 class="programas__subtitulo ac-blanco" data-read>Libertad y democracia</h2>
    </div>
      
      <span class="programas__texto ac-blanco" data-read>
        Sabemos que han sido tiempos en los <br> 
        que la marea sube y las tormentas <br>
        amenazan con llevarse todo por delante, <br>
        por eso la esperanza late de la mano de <br>
        las iniciativas que fortalecen la <br>
        democracia a través de procesos que<br>
        abordan discursos y narrativas contra los <br>
        fundamentalismos; la promoción de la <br>
        autonomía y el derecho al cuerpo; la <br>
        defensa de los derechos de las personas <br>
        LBTIQ+; y de quienes construyen <br>
        espacios que abrazan a las familias <br>
        amplias y diversas.
      </span>
      <span class="programas__cifra ac-blanco" data-read>88 propuestas</span>
    </div>
  </article>

  <!-- BLOQUE 2 · AUTONOMÍA, DERECHOS Y SOSTENIBILIDAD -->
  <article
    class="programas__bloque programas__bloque--autonomia"
    data-anim-item
  >
  
      

    <div class="programas__info">
      <div class="titulo__contenedor">
    <div class="programas__circulo programas__circulo--autonomia">
      <img
        src="/resources/escenario/escenario-caracol.webp"
        alt=""
        class="programas__icono"
        width="48"
        height="48"
        loading="lazy"
      />
    </div>
      <h2 class="programas__subtitulo ac-blanco" data-read>Autonomía, derechos y sostenibilidad</h2>
      </div>
      <p class="programas__texto ac-blanco" data-read>
        El mar con su riqueza e inmensidad nos enseñó la importancia de
        fortalecer las colectividades en su sostenibilidad y autonomía para
        navegar con firmeza, por eso navegamos junto a organizaciones que
        transforman sus territorios para la construcción de paz, que le apuestan
        a la defensa del territorio y la eliminación de cualquier tipo de
        violencia.
      </p>
      <span class="programas__cifra ac-blanco" data-read>94 propuestas</span>
    </div>
  </article>
  
  <div class="flechaMovil">
    <FlechaNav
      direccion="derecha"
      class="next-button"
    />
    <FlechaNav
      direccion="izquierda"
      class="prev-button"
    />
  </div>
  


  

</section>

<script>

  const letreroRosaSolo = document.querySelector(".imagen_escena_9_7");
  const letreroNaranjaSolo  = document.querySelector(".imagen_escena_9_6");
  const difRosaSolo = document.querySelector(".imagen_escena_9_3");
  const difNaranjaSolo  = document.querySelector(".imagen_escena_9_2");
  const flechaMovil = document.querySelector(".flechaMovil");
  
  const nextButton = document.querySelector(".next-button");
  const prevButton = document.querySelector(".prev-button");

  
  const infoNaranja = document.querySelector(".programas__bloque--libertad");
  const infoRosa = document.querySelector(".programas__bloque--autonomia");



    letreroRosaSolo.style.setProperty("display", "none", "important");
    prevButton.style.setProperty("display", "none", "important");
  

    nextButton.addEventListener("click", () => {
    letreroNaranjaSolo.style.setProperty("display", "none", "important");
    letreroRosaSolo.style.setProperty("display", "flex", "important");
    prevButton.style.setProperty("display", "flex", "important");
    nextButton.style.setProperty("display", "none", "important");
    flechaMovil.style.setProperty("right", "auto", "important");
    flechaMovil.style.setProperty("left", "-20vw", "important");
    flechaMovil.style.setProperty("position", "absolute", "important");
    infoNaranja.style.setProperty("display", "none", "important");
    infoRosa.style.setProperty("display", "flex", "important");
    difNaranjaSolo.style.setProperty("display", "none", "important");
    difRosaSolo.style.setProperty("display", "flex", "important");
  });

    prevButton.addEventListener("click", () => {
    letreroRosaSolo.style.setProperty("display", "none", "important");
    letreroNaranjaSolo.style.setProperty("display", "flex", "important");
    nextButton.style.setProperty("display", "flex", "important");
    prevButton.style.setProperty("display", "none", "important");
    flechaMovil.style.setProperty("left", "auto", "important");
    flechaMovil.style.setProperty("right", "-20vw", "important");
    flechaMovil.style.setProperty("position", "absolute", "important");
    infoNaranja.style.setProperty("display", "flex", "important");
    infoRosa.style.setProperty("display", "none", "important");
    difNaranjaSolo.style.setProperty("display", "flex", "important");
    difRosaSolo.style.setProperty("display", "none", "important");
  });


</script>

<style>

  

.ac-blanco br{
  display: none;
}
.flechaMovil{
  display: none;
}
  
  .navegacionMobile{
    display: none;
  }

  
  .titulo__contenedor{
    display: flex;
    flex-direction: row;
  }
  .container {
    position: absolute;
    bottom: 18vh;
    flex-direction: row;
    display: flex;
    justify-self: center;
    margin-left: 67vh;
    gap: 7vh;
  }
  .programas {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .programas__titulo {
    position: absolute;
    top: calc(var(--alto) * 18 / 100);
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 5.4 / 100 * var(--zoom-letra, 1));
    font-weight: 700;
    color: var(--azul-noche);
    margin: 0;
    justify-self: center;
    margin-left: 25vh;
  }

  /* ─── Mapa ─── */

  .programas__mapa {
    position: absolute;
    top: calc(var(--alto) * 13 / 100);
    width: 77vh;
    height: calc(var(--alto) * 50 / 100);
        justify-self: center;
    margin-right: 92vh;
  }

  /* ─── Bloques ─── */

  .programas__bloque {
    display: flex;
    flex-direction:row;
  }

  .programas__bloque--libertad {
    top: calc(var(--alto) * 38 / 100);
    right: 14.5vw;
  }

  .programas__bloque--autonomia {
    top: calc(var(--alto) * 38 / 100);
    right: -12.5vw;
  }

  /* ─── Estrella decorativa de 12 puntas ─── */

  .programas__circulo {
    flex-shrink: 0;
    width: calc(var(--alto) * 6.5 / 100);
    height: calc(var(--alto) * 6.5 / 100);
    clip-path: polygon(
      50% 0%,
      60% 10%,
      75% 5%,
      80% 20%,
      95% 25%,
      90% 40%,
      100% 50%,
      90% 60%,
      95% 75%,
      80% 80%,
      75% 95%,
      60% 90%,
      50% 100%,
      40% 90%,
      25% 95%,
      20% 80%,
      5% 75%,
      10% 60%,
      0% 50%,
      10% 40%,
      5% 25%,
      20% 20%,
      25% 5%,
      40% 10%
    );
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .programas__circulo--libertad {
    background-color: #539D94;
  }

  .programas__circulo--autonomia {
    background-color: #F5AA06;
  }

  :global(html.modo-alto-contraste .programas__circulo--libertad),
  :global(html.modo-alto-contraste .programas__circulo--autonomia) {
    background-color: #FFFFFF !important;
  }

  :global(html.modo-alto-contraste .programas__icono) {
    filter: brightness(0.15) !important;
  }

  .programas__icono {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ─── Info ─── */

  .programas__info {
    justify-content: center;
    display: flex;
    flex-direction: column;
    position: relative;
    width: 35vh;
    margin-left: 1vh;
    
  }

  .programas__subtitulo {
    font-family: var(--font-discordia);
    font-size: 2.2vh;
    font-weight: 700;
    color: var(--azul-noche);
    margin: 0;
    line-height: 1.2;
    align-items: center;
        display: flex;
  }

  .programas__texto {
    overflow: hidden;
    font-family: var(--font-lato);
    font-size: 2vh;
    color: var(--azul-noche);
    margin: 0;
    width: 95%;
    align-self: center;
    height: 35vh;
  }

  .programas__cifra {
    font-family: var(--font-discordia);
    font-size: 2.2vh;
    font-weight: 700;
    color: var(--azul-noche);
    display: inline-block;
    text-align: center;
  }

  @media (max-width: 640px) {

    .programas{
          justify-content: center;
    display: flex;

    }

    .programas__info{
      width: 24vh;
    }

    .navegacionDesktop {
        display: none;
      }
      .navegacionMobile{
    display: flex;
  }

    .programas__mapa{
      margin-right: 16vw;
      position: absolute ; 
      top: 10vh;
      width: 40vh;
      height: calc(var(--alto) * 40 / 100);
    }

    .container{
      margin-left: 0;
      gap: 0;
          bottom: 19vh;

    }

    .programas__bloque--autonomia{
      display: none;
    }

    .programas__texto{
      font-size: 1.1vh;
      width: 20vh;
          height: 16vh;
    }

    .programas__subtitulo{
    font-size: 1.4vh;
  }

  .programas__circulo{
    
    width: calc(var(--alto) * 4.5 / 100);
    height: calc(var(--alto) * 4.5 / 100);
  }

  .programas__cifra{
        font-size: 1.6vh;
  }
  .titulo__contenedor{
    justify-content: center;
  }
  .programas__titulo{
        font-size: 3vh;
    margin-right: 40vw;
    margin-left: 0;
    top: 5vh;
  }

  .flechaMovil{
  display: flex;
  position: absolute;
        right: -20vw;
        top: 6vh;
}

  .mapa__visor{
    width: 45vh;
    height: 45vh;
  }

  }


</style>
