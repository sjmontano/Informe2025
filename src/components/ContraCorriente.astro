---
/**
 * ESCENA 14 · A CONTRACORRIENTE
 *
 * Podcast con descripción, botón de volver e íconos de
 * Spotify y YouTube con doble círculo decorativo.
 */
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BotonVolver from "./BotonVolver.astro";

const svgSpotify = readFileSync(
  join(process.cwd(), "public", "resources", "iconos", "icon-spotify.svg"),
  "utf-8",
).replace(/fill="[^"]*"/g, 'fill="currentColor"');

const svgYoutube = readFileSync(
  join(process.cwd(), "public", "resources", "iconos", "icon-youtube.svg"),
  "utf-8",
).replace(/fill="[^"]*"/g, 'fill="currentColor"');

const SPOTIFY_URL =
  "https://open.spotify.com/show/318xWjM52nEA659i9iKKTj?si=98a77bfca9eb4aef";
const YOUTUBE_URL =
  "https://www.youtube.com/playlist?list=PLkwIXeK8TV-_4trn-s-6Ya9CCIsMTGnqd";
---

<section
  class="contracorriente anim-entrada anim-entrada--fade"
  data-anim-stagger="200"
>
  <BotonVolver
    href="/investigacion"
    texto="Investigación"
    top={5}
    right={15}
    z={3}
  />
  <BotonVolver href="/" variante="circulo" bottom={3} left={15} z={3} />

  <!-- COLUMNA IZQUIERDA: título + descripción + íconos -->
  <div class="contracorriente__izquierda">
    <h1 class="contracorriente__titulo" data-anim-item>A contra corriente</h1>

    <span class="contracorriente__badge" data-anim-item>Podcast</span>

    <p class="contracorriente__intro" data-anim-item>
      El podcast A contracorriente es el resultado <br />
      de un proceso de investigación colaborativo <br />
      con colectivas y organizaciones de mujeres <br />
      con discapacidades de Cartagena, que responde <br />
      preguntas alrededor de la experiencia de <br />
      discapacidad y la intersección de la violencia <br />
      capacitista con otras formas de opresión.<br />
    </p><br />

    <p class="contracorriente__intro" data-anim-item>
      Esta investigación se consolida como una <br />
      apuesta alrededor de problemas poco indagados <br />
      e invisibilizados; y como un llamado urgente <br />
      y profundamente político a reflexionar sobre <br />
      las lógicas de exclusión capacitista, no solo como <br />
      un asunto individual, sino estructural, en una<br />
      sociedad que configura la diversidad de cuerpos <br />
      en «normales» y «anormales».
    </p>
  </div>

  <!-- Íconos de plataformas: columna, abajo-derecha -->
  <div class="contracorriente__plataformas" data-anim-item>
    <a
      class="contracorriente__circulo-ext"
      href={SPOTIFY_URL}
      target="_blank"
      rel="noopener"
      aria-label="Escuchar en Spotify"
    >
      <span class="contracorriente__circulo-int" set:html={svgSpotify} />
    </a>

    <a
      class="contracorriente__circulo-ext"
      href={YOUTUBE_URL}
      target="_blank"
      rel="noopener"
      aria-label="Ver en YouTube"
    >
      <span class="contracorriente__circulo-int" set:html={svgYoutube} />
    </a>
  </div>

  <style>
    .contracorriente {
      position: absolute;
      inset: 0;
      z-index: 2;
    }

    /* ─── Columna izquierda ─── */

    .contracorriente__izquierda {
      position: absolute;
      top: 16vh;
      left: 17%;
      width: 60%;
    }

    .contracorriente__titulo {
      font-family: var(--font-discordia);
      font-size: 3.4vw;
      font-weight: 700;
      color: var(--azul-noche);
      margin: 0 0 calc(var(--alto) * 1.5 / 100);
      line-height: 1.1;
    }

    .contracorriente__badge {
      display: inline-block;
      font-family: var(--font-discordia);
      font-size: calc(var(--alto) * 2.6 / 100);
      font-style: italic;
      font-weight: 400;
      background-color: var(--oceano);
      color: var(--arena);
      width: fit-content;
      border-radius: var(--espacio-4xl);
      padding: calc(var(--alto) * 0.3 / 100) calc(var(--alto) * 5 / 100);
      margin-bottom: calc(var(--alto) * 2 / 100);
    }

    .contracorriente__intro {
      margin-top: 3vw;
      font-family: var(--font-lato);
      font-size: 1.3vw;
      line-height: 1.5vw;
      color: var(--azul-noche);
      width: 55%;
      white-space: normal;
      margin: 0;
    }

    /* ─── Plataformas: columna, abajo-derecha ─── */

    .contracorriente__plataformas {
      position: absolute;
      right: 42%;
      bottom: 25vh;
      display: flex;
      flex-direction: column;
      gap: calc(var(--alto) * 2 / 100);
    }

    .contracorriente__circulo-ext,
    .contracorriente__circulo-int {
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
    }

    .contracorriente__circulo-ext {
      background-color: var(--azul-noche);
      width: 12vh;
      height: 12vh;
      text-decoration: none;
      transition:
        transform 0.3s ease,
        outline 0.3s ease;
    }

    .contracorriente__circulo-ext:hover {
      transform: scale(1.2);
      outline: 3px solid var(--salmon);
      outline-offset: 3px;
    }

    .contracorriente__circulo-int {
      background-color: var(--azul-noche);
      color: var(--azul-noche);
      width: 100%;
      height: 100%;
    }

    .contracorriente__circulo-int :global(svg) {
      width: 65%;
      height: 65%;
    }
  </style>
</section>
