---
/**
 * ESCENA 14 · LABORATORIO DE GÉNERO Y FEMINISMOS
 *
 * Visor PDF, texto descriptivo y botón de descarga + volver.
 */
import BotonVolver from "./BotonVolver.astro";
---

<section
  class="laboratorio anim-entrada anim-entrada--fade"
  data-anim-stagger="200"
>
  <BotonVolver
    href="/investigacion"
    texto="Investigación"
    top={5}
    right={15}
    z={3}
    background="var(--oceano)" 
  />
  <BotonVolver href="/#navegacion" variante="circulo" bottom={8} left={15} z={3}  />

  <div class="laboratorio__contenido">
    <div class="laboratorio__visor" data-anim-item>
      <img
        class="laboratorio__marco"
        src="/resources/contenedor/contenedor-fotos.webp"
        alt="Marco decorativo para el visor de PDF"
        loading="lazy"
      />
      <embed
        class="laboratorio__pdf"
        src="https://online.fliphtml5.com/Redes_Lunaria/jnmk/#p=1"
        type="application/pdf"
        width="100%"
        height="100%"
      />
      <button class="laboratorio__descargar" type="button">Descargar</button>
    </div>

    <div class="laboratorio__texto" data-anim-item>
      <h1 class="laboratorio__titulo">
        Puntos de partida.<br />
        Hilando feminismos<br />
        para quienes inician
      </h1>
      <h2 class="laboratorio__subtitulo">Laboratorio de género y feminismos</h2>
      <p class="laboratorio__parrafo">
        El laboratorio en feminismos fue un proceso formativo<br />
        virtual abierto a mujeres jóvenes que han empezado<br />
        una exploración inicial en los feminismos. Este tenía <br />
        como objetivo que las jóvenes desarrollaran un<br />
        pensamiento y una práctica feminista amplia, diversa<br />
        e incluyente, mediante el diálogo y reflexión de <br />
        referentes teóricos y prácticas políticas que <br />
        contrarrestan discursos y militancias esencialistas,<br />
        racistas y transexcluyentes.
      </p>
      <p class="laboratorio__parrafo">
        El laboratorio habilitó un espacio seguro para la <br />
        reflexión y el debate sobre el sujeto político del <br />
        feminismo y la interseccionalidad; los feminismos <br />
        antirracistas, transfeminismo y feminismos <br />
        trans-excluyentes; y los relevos generacionales <br />
        y buenas prácticas dentro de los activismos feministas.
      </p>
    </div>
  </div>
</section>

<style>
  .laboratorio {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .laboratorio__contenido {
    position: absolute;
    top: calc(var(--alto) * 14 / 100);
    left: 5%;
    width: 95%;
    display: flex;
    gap: 7vw;
  }

  .laboratorio__visor {
    margin-top: calc(var(--alto) * 5 / 100);
    position: relative;
    width: 35%;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .laboratorio__marco {
    position: absolute;
    top: -5vh;
    width: 100%;
    height: 40vh;
    z-index: 0;
    pointer-events: none;
  }

  .laboratorio__pdf {
    position: relative;
    width: 83%;
    height: 30vh;
    border: none;
    background-color: var(--azul-noche);
    border-radius: 2%;
    z-index: 1;
    display: block;
    margin-inline: auto;
  }

  .laboratorio__descargar {
    position: absolute;
    top: calc(var(--alto) * 31.5 / 100);
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--arena);
    color: var(--azul-noche);
    border: none;
    border-radius: 1.7vh;
    padding: calc(var(--alto) * 0.8 / 100) calc(var(--alto) * 2.5 / 100);
    font-family: var(--font-lato);
    font-size: calc(var(--alto) * 2.2 / 100);
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease;
    z-index: 2;
  }

  .laboratorio__descargar:hover {
    transform: translateX(-50%) scale(1.05);
  }

  .laboratorio__descargar:active {
    transform: translateX(-50%) scale(0.95);
  }

  .laboratorio__texto {
    color: var(--azul-noche);
  }

  .laboratorio__titulo {
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 4.7 / 100);
    line-height: 1.2;
    font-weight: 700;
    color: var(--azul-noche);
    margin-top: 0;
    margin-bottom: calc(var(--alto) * 2 / 100);
  }

  .laboratorio__subtitulo {
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 2.6 / 100);
    font-style: italic;
    font-weight: 400;
    background-color: var(--oceano);
    color: var(--arena);
    width: fit-content;
    border-radius: 1.7vh;
    padding: calc(var(--alto) * 0.3 / 100) calc(var(--alto) * 4 / 100);
    margin-bottom: calc(var(--alto) / 100);
    margin-left: calc(var(--alto) * -4 / 100);
  }

  .laboratorio__parrafo {
    font-family: var(--font-lato);
    font-size: calc(var(--alto) * 2.25 / 100);
    line-height: calc(var(--alto) * 2.7 / 100);
    color: var(--azul-noche);
  }

  
  @media (max-width: 570px) {

  }
</style>

<script>
  document
    .querySelector(".laboratorio__descargar")
    ?.addEventListener("click", () => {
      const link = document.createElement("a");
      link.href = "/Silencios_2024.pdf";
      link.download = "Silencios_2024.pdf";
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
</script>
