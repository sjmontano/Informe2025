---
/**
 * ESCENA 11 · INVESTIGACIÓN
 *
 * Título, texto introductorio y 3 enlaces a subsecciones.
 */
import BotonVolver from "./BotonVolver.astro";
---

<section
  class="investigacion anim-entrada anim-entrada--fade"
  data-anim-stagger="250"
>
  <BotonVolver href="/#navegacion" variante="circulo" bottom={4} left={4} z={3} />

  <div class="investigacion__texto" data-anim-item>
    <h1 class="investigacion__titulo" data-read>Investigación</h1>
    <p class="investigacion__intro" data-read>
      La brújula nos guió a cuestionarnos por un lugar <br>
      donde puedan acceder todas las personas. Por eso, <br>
      nos preguntamos por las violencias que enfrentan las <br>
      mujeres con discapacidad en la investigación:
    </p>
  </div>

  <nav class="investigacion__nav" aria-label="Secciones de investigación">
    <a
      class="investigacion__enlace ac-blanco"
      href="/investigacion/contracorriente"
      data-anim-item data-read>A contracorriente</a
    >
    <a
      class="investigacion__enlace ac-blanco"
      href="/investigacion/diplomado"
      data-anim-item data-read>Diplomado 3.0</a
    >
    <a
      class="investigacion__enlace ac-blanco"
      href="/investigacion/laboratorio"
      data-anim-item data-read
    >
      Laboratorio de género<br />y feminismos
    </a>
  </nav>
</section>

<style>
  .investigacion {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .investigacion__texto {
    position: absolute;
    top: calc(var(--alto) * 7 / 100);
    left: 20%;
  }

  .investigacion__titulo {
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 5.6 / 100 * var(--zoom-letra, 1));
    font-weight: 700;
    color: var(--azul-noche);
    margin: 0 0 calc(var(--alto) * 1.8 / 100);
  }

  .investigacion__intro {
    font-family: var(--font-lato);
    font-size: calc(var(--alto) * 2.2 / 100 * var(--zoom-letra, 1));
    color: var(--azul-noche);
    margin: 0;
  }

  .investigacion__nav {
    position: absolute;
    top: calc(var(--alto) * 24 / 100);
    right: 22vh;
    display: flex;
    flex-direction: column;
    gap: 14vh;
    align-items: center;
    top: auto;
    bottom: 29vh;
  }

  .investigacion__enlace {
    font-family: var(--font-discordia);
    font-size: 3vh;
    line-height: 1.3;
    font-weight: 700;
    color: var(--azul-noche);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .investigacion__enlace:hover {
    transform: scale(1.08);
  }

  
  @media (max-width: 570px) {
    .investigacion__titulo {
    font-size: 2.5vh;
    margin: 0;
    }
    .investigacion__intro{
    font-size: 1.2vh;
}
.investigacion__enlace {
    font-size: 1.6vh;
}
.investigacion__nav{
    gap: 5.9vh;
    top: 29.5vh;
    bottom: auto;
    right: auto;
    margin-left: 14vh;
}
.investigacion {
        justify-content: center;
    display: flex;
}

.investigacion__texto {
    margin-left: 12vw;
    left: auto;
}


  }
</style>
