---
/**
 * ESCENA 7 · EN MOVIMIENTO
 *
 * Sección En Movimiento, dentro de Estrategias de Acción.
 */
import BotonVolver from "./BotonVolver.astro";
---

<section
  class="en-movimiento anim-entrada anim-entrada--fade"
  data-anim-stagger="200"
>
  <BotonVolver href="/estrategias" texto="Estrategias" top={3} right={6} z={3} />

  <h1 class="en-movimiento__titulo" data-anim-item data-read>En movimiento</h1>
</section>

<style>
  .en-movimiento {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .en-movimiento__titulo {
    position: absolute;
    top: calc(var(--alto) * 14 / 100);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 5.4 / 100 * var(--zoom-letra, 1));
    font-weight: 700;
    color: var(--azul-noche);
    margin: 0;
  }
</style>
