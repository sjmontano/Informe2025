---
/**
 * BotonVolver.astro — Botón de navegación hacia atrás
 *
 * Props:
 *   href     — destino (ej. "/investigacion")
 *   texto    — etiqueta (default "Volver"). Ignorado si variante="circulo"
 *   top      — posición desde arriba (N en --alto)
 *   right    — posición desde la derecha
 *   bottom   — posición desde abajo (N en --alto), reemplaza a top
 *   left     — posición desde la izquierda, reemplaza a right
 *   z        — z-index (default 3)
 *   variante — "default" (regresar.webp + texto) | "circulo" (SVG con texto incluido)
 */

export interface Props {
  href: string;
  texto?: string;
  top?: number;
  right?: number;
  bottom?: number;
  left?: number;
  z?: number;
  variante?: "default" | "circulo" | "estrategia";
  color?: string;
  background?: string;
  extraStyle?: string;
}

const {
  href,
  texto = "Volver",
  top,
  right,
  bottom,
  left,
  z = 3,
  variante = "default",
  color = "var(--arena)",
  background = "transparent",
  extraStyle = "",
} = Astro.props;

const estilo = [
  top != null ? `top: calc(var(--alto) * ${top} / 100)` : "",
  right != null ? `right: calc(var(--alto) * ${right} / 100)` : "",
  bottom != null ? `bottom: calc(var(--alto) * ${bottom} / 100)` : "",
  left != null ? `left: calc(var(--alto) * ${left} / 100)` : "",
  color != null ? `color: ${color}` : "var(--arena)",
  background != null ? `background-color: ${background}` : "var(--oceano)",
  `z-index: ${z}`,
  extraStyle,
]
  .filter(Boolean)
  .join("; ");
---

<a
  class={`boton-volver${variante === "circulo" ? " boton-volver--circulo" : ""}`}
  href={href}
  style={estilo}
  data-anim-item
>
  {
    variante === "circulo" ? (
      <img
        class="boton-volver__circulo"
        src="/resources/ui/ui-regresar-1.svg"
        alt="Volver al menú principal"
        loading="lazy"
      />
    ) : variante === "estrategia" ? (
      <>
        <img
          class="boton-volver__icono"
          src="/resources/ui/regresar.svg"
          alt="Volver al menú principal"
          loading="lazy"
        />
        <span class="boton-volver__texto">{texto}</span>
      </>
    ) : (
      <>
        <img
          class="boton-volver__icono"
          src="/resources/ui/regresar.webp"
          alt=""
          loading="lazy"
        />
        <span class="boton-volver__texto">{texto}</span>
      </>
    )
  }
</a>

<style>
  .boton-volver {
    position: absolute;
    display: flex;
    align-items: center;
    gap: calc(var(--alto) * 1.7 / 100);
    text-decoration: none;
    border-radius: var(--espacio-sm);
    padding: calc(var(--alto) * 0.7 / 100) calc(var(--alto) * 1 / 100);
    transition: transform 0.2s ease;
  }

  .boton-volver:hover {
    transform: scale(1.05);
  }

  .boton-volver__icono {
    width: calc(var(--alto) * 4 / 100);
    height: calc(var(--alto) * 4 / 100);
    object-fit: contain;
  }

  .boton-volver__texto {
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 2.6 / 100);
    font-weight: 700;
  }

  /* ─── Variante círculo ─── */

  .boton-volver--circulo {
    background-color: transparent;
    padding: 0;
    border-radius: 0;
  }

  .boton-volver--circulo:hover {
    transform: scale(1.1);
  }

  .boton-volver__circulo {
    width: calc(var(--alto) * 11 / 100);
    height: calc(var(--alto) * 11 / 100);
    object-fit: contain;
  }

  @media (max-width: 570px) {
    .boton-volver__texto {
      font-family: var(--font-discordia);
      font-size: 1.6vh !important;
      font-weight: 700;
    }

    .boton-volver__icono {
      width: 3vh;
      height: 3vh;
      object-fit: contain;
    }
  }
</style>
