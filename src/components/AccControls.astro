---
/**
 * AccControls.astro — Panel flotante de accesibilidad
 *
 * Alto contraste · Reducir movimiento · Tamaño de letra · Modo noche
 * Persiste en localStorage. Sin dependencias externas.
 */
---

<div class="acc-controls" role="group" aria-label="Controles de accesibilidad">
  <button
    class="acc-btn acc-btn--open"
    id="acc-toggle"
    aria-label="Abrir controles de accesibilidad"
    aria-expanded="false"
  >
    <svg
      viewBox="0 0 24 24"
      width="24"
      height="24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M12 8v8M8 12h8"></path>
    </svg>
  </button>

  <div class="acc-panel" id="acc-panel">
    <span class="acc-panel__title">Accesibilidad</span>

    <!-- Alto contraste -->
    <div class="acc-row">
      <button
        class="acc-tog"
        id="acc-hc"
        aria-pressed="false"
        aria-label="Activar alto contraste"
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2v20M2 12h20"></path>
        </svg>
      </button>
      <span class="acc-label">Alto contraste</span>
    </div>

    <!-- Modo noche -->
    <div class="acc-row">
      <button
        class="acc-tog"
        id="acc-night"
        aria-pressed="false"
        aria-label="Activar modo noche"
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <span class="acc-label">Modo noche</span>
    </div>

    <!-- Reducir movimiento -->
    <div class="acc-row">
      <button
        class="acc-tog"
        id="acc-rm"
        aria-pressed="false"
        aria-label="Reducir animaciones"
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </button>
      <span class="acc-label">Reducir movimiento</span>
    </div>

    <!-- Tamaño de letra -->
    <div class="acc-row">
      <button
        class="acc-size"
        id="acc-font-minus"
        aria-label="Reducir tamaño de letra"
        disabled>A⁻</button
      >
      <span class="acc-label">Tamaño de letra</span>
      <button
        class="acc-size"
        id="acc-font-plus"
        aria-label="Aumentar tamaño de letra">A⁺</button
      >
    </div>

    <button
      class="acc-reset"
      id="acc-reset"
      aria-label="Restablecer todos los ajustes"
    >
      Restablecer
    </button>
  </div>
</div>

<script type="module" src="/scripts/acc-controls.js"></script>

<style>
  /* ─── Botón principal ─── */
  .acc-btn--open {
    all: unset;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    border: 2px solid #28275b;
    background: #f4c454;
    color: #28275b;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Lato", sans-serif;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .acc-btn--open:hover,
  .acc-btn--open:focus-visible {
    background: #ef7e7b;
    transform: scale(1.1);
  }

  /* ─── Panel ─── */
  .acc-panel {
    display: none;
    flex-direction: column;
    gap: 0.6rem;
    background: #f4c454;
    border: 2px solid #28275b;
    border-radius: 12px;
    padding: 0.8rem 1rem;
    min-width: 210px;
    font-family: "Lato", sans-serif;
    color: #28275b;
    position: fixed;
    bottom: 4rem;
    right: 1rem;
    z-index: 9999;
  }
  .acc-panel--open {
    display: flex;
  }

  .acc-panel__title {
    font-family: "Discordia", serif;
    font-size: 1rem;
    font-weight: 700;
    color: #28275b;
    text-align: center;
    margin-bottom: 0.2rem;
  }

  /* ─── Filas ─── */
  .acc-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .acc-label {
    font-size: 0.85rem;
    color: #28275b;
    flex: 1;
  }

  /* ─── Toggles circulares ─── */
  .acc-tog,
  .acc-size {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    border-radius: 50%;
    border: 2px solid #28275b;
    background: #f0f4ff;
    color: #28275b;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    font-size: 0.9rem;
    font-weight: 700;
    font-family: "Lato", sans-serif;
    transition: background 0.2s;
  }
  .acc-tog[aria-pressed="true"] {
    background: #28275b;
    color: #f4c454;
  }
  .acc-tog:hover,
  .acc-tog:focus-visible,
  .acc-size:hover,
  .acc-size:focus-visible {
    background: #ef7e7b;
    color: #28275b;
  }
  .acc-size:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .acc-size:disabled:hover {
    background: #f0f4ff;
    color: #28275b;
  }

  /* ─── Reset ─── */
  .acc-reset {
    all: unset;
    border: 2px solid #28275b;
    color: #28275b;
    border-radius: 9999px;
    padding: 0.3rem 1rem;
    font-family: "Lato", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    text-align: center;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .acc-reset:hover,
  .acc-reset:focus-visible {
    background: #ef7e7b;
    color: #28275b;
  }

  /* ─── Auto-protección: estos estilos nunca se modifican ─── */
  .acc-controls {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  /* ═══════════════════════════════════════════════════════════════
     EFECTOS GLOBALES — :global() necesario porque apuntan a
     elementos fuera de este componente (scene-wrapper, img, etc.)
     ═══════════════════════════════════════════════════════════════ */

  /* ─── ALTO CONTRASTE (WCAG AAA) ───
       Fondo blanco puro #FFFFFF, texto negro puro #000000 (21:1).
       Imágenes desaturadas. Botones, badges y contenedores con
       borde negro para mantener jerarquía visual sin depender del color.
       Logo Lunaria y marcas excluidos. */

  /* Pagina /accesibilidad — mantener filtro original */
  :global(html.modo-alto-contraste .acc-contenido) {
    filter: contrast(1.45) saturate(1.2) !important;
  }

  /* 1. Fondo semitransparente — la escena de fondo se ve
       tenuemente para que el contenido no parezca flotando */
  :global(html.modo-alto-contraste:not(.modo-noche) .escena-contenido) {
    background: rgba(255, 255, 255, 0.88) !important;
  }

  /* 2. Variables → solo las que son texto puro.
       --oceano / --turquesa / --mapa-* se DEJAN originales
       para que el mapa de Colombia y barras mantengan estructura. */
  :global(html.modo-alto-contraste:not(.modo-noche)) {
    --arena: #FFFFFF !important;
    --azul-noche: #000000 !important;
    --blanco: #000000 !important;
    --petroleo: #000000 !important;
    --naranja-madera: #000000 !important;
    --salmon: #FFFFFF !important;
    --coral: #000000 !important;
    --circulo-fondo: #000000 !important;
    --circulo-texto: #FFFFFF !important;
  }

  /* 3. Todo texto en negro puro (sin background-color para
       que los contenedores mantengan su bg original) */
  :global(html.modo-alto-contraste:not(.modo-noche) .escena-contenido *),
  :global(html.modo-alto-contraste:not(.modo-noche) .acc-contenido *) {
    color: #000000 !important;
  }

  /* 4. Imágenes — no heredan color */
  :global(html.modo-alto-contraste:not(.modo-noche) .escena-contenido img),
  :global(html.modo-alto-contraste:not(.modo-noche) .escena-contenido svg),
  :global(html.modo-alto-contraste:not(.modo-noche) .escena-contenido video),
  :global(html.modo-alto-contraste:not(.modo-noche) .escena-contenido canvas) {
    color: initial !important;
    background-color: initial !important;
  }

  /* 5. TODO contenedor con bg → fondo blanco + borde negro.
       Abarca Cuentas, Carta, Estrategias, Testimonios,
       LosTrapos, Laboratorio, Diplomado, ContraCorriente,
       Talleres, Contenido, Inicio, Aliados, Mapa. */
  :global(html.modo-alto-contraste:not(.modo-noche) .progress__contenedor),
  :global(html.modo-alto-contraste:not(.modo-noche) .progress__barra),
  :global(html.modo-alto-contraste:not(.modo-noche) .carta__cifra),
  :global(html.modo-alto-contraste:not(.modo-noche) .estrategias__block),
  :global(html.modo-alto-contraste:not(.modo-noche) .estrategias__badge),
  :global(html.modo-alto-contraste:not(.modo-noche) .estrategias__conexion),
  :global(html.modo-alto-contraste:not(.modo-noche) .testimonios__tarjeta),
  :global(html.modo-alto-contraste:not(.modo-noche) .testimonios__leer),
  :global(html.modo-alto-contraste:not(.modo-noche) .testimonios__punto),
  :global(html.modo-alto-contraste:not(.modo-noche) .los-trapos__circulo-ext),
  :global(html.modo-alto-contraste:not(.modo-noche) .laboratorio__pdf),
  :global(html.modo-alto-contraste:not(.modo-noche) .laboratorio__subtitulo),
  :global(html.modo-alto-contraste:not(.modo-noche) .laboratorio__descargar),
  :global(html.modo-alto-contraste:not(.modo-noche) .diplomado__subtitulo),
  :global(html.modo-alto-contraste:not(.modo-noche) .contenedor-taller-numeracion),
  :global(html.modo-alto-contraste:not(.modo-noche) .taller-titulo),
  :global(html.modo-alto-contraste:not(.modo-noche) .contracorriente__badge),
  :global(html.modo-alto-contraste:not(.modo-noche) .contracorriente__circulo-ext),
  :global(html.modo-alto-contraste:not(.modo-noche) .contenido__btn),
  :global(html.modo-alto-contraste:not(.modo-noche) .inicio__subtitulo),
  :global(html.modo-alto-contraste:not(.modo-noche) .aliados__contenedor),
  :global(html.modo-alto-contraste:not(.modo-noche) .mapa__tooltip--libertad),
  :global(html.modo-alto-contraste:not(.modo-noche) .mapa__tooltip--autonomia),
  :global(html.modo-alto-contraste:not(.modo-noche) .mapa__tooltip--nombre) {
    background: #FFFFFF !important;
    border: 2px solid #000000 !important;
    color: #000000 !important;
  }

  /* Círculos interiores (checkmark) → transparentes */
  :global(html.modo-alto-contraste:not(.modo-noche) .los-trapos__circulo-int),
  :global(html.modo-alto-contraste:not(.modo-noche) .contracorriente__circulo-int) {
    background: transparent !important;
    border: none !important;
  }

  /* 6. Botones — fondo blanco, borde negro, texto negro */
  :global(html.modo-alto-contraste:not(.modo-noche) .boton-volver:not(.boton-volver--circulo)) {
    background: #FFFFFF !important;
    border: 2px solid #000000 !important;
    color: #000000 !important;
  }

  /* 7. Imágenes decorativas — desaturadas */
  :global(html.modo-alto-contraste:not(.modo-noche) .scene-wrapper .fondos__img),
  :global(html.modo-alto-contraste:not(.modo-noche) .scene-wrapper .fondos__lqip),
  :global(html.modo-alto-contraste:not(.modo-noche) .scene-wrapper .escena__img),
  :global(html.modo-alto-contraste:not(.modo-noche) .scene-wrapper img[src*="/gifs/"]) {
    filter: saturate(0.2) !important;
  }

  /* Contenedor — solo borde negro, centro blanco (sobrexpuesto).
       brightness(0) vuelve negro todo píxel visible; el centro
       transparente muestra el fondo blanco de escena-contenido.
       Especificidad mayor que .escena__img para ganarle. */
  :global(html.modo-alto-contraste:not(.modo-noche) .scene-wrapper .escena-contenido img[src*="/contenedor/"]) {
    filter: brightness(0) !important;
  }

  /* 8. Modo noche + alto contraste — desaturar preservando efectos de noche */
  :global(html.modo-alto-contraste.modo-noche .scene-wrapper .fondos__img),
  :global(html.modo-alto-contraste.modo-noche .scene-wrapper .fondos__lqip) {
    filter: brightness(0.3) saturate(0.2) invert(1) hue-rotate(180deg) !important;
  }
  :global(html.modo-alto-contraste.modo-noche .scene-wrapper .escena__img) {
    filter: brightness(0.5) saturate(0.2) invert(1) hue-rotate(180deg) !important;
  }
  :global(html.modo-alto-contraste.modo-noche .scene-wrapper img[src*="/gifs/"]) {
    filter: brightness(0.6) saturate(0.2) invert(1) hue-rotate(180deg) !important;
  }

  /* Logo Lunaria y marcas — nunca afectadas */
  :global(html.modo-alto-contraste .scene-wrapper img[src*="marca-lunaria"]),
  :global(html.modo-alto-contraste .scene-wrapper img[src*="/marcas/"]) {
    filter: none !important;
  }

  /* 9. Enlaces y botones subrayados */
  :global(html.modo-alto-contraste a),
  :global(html.modo-alto-contraste button) {
    text-decoration: underline !important;
    text-decoration-thickness: 2px !important;
    text-underline-offset: 2px !important;
  }

  /* 10. Focus visible */
  :global(html.modo-alto-contraste *:focus-visible) {
    outline: 3px solid #000000 !important;
    outline-offset: 3px !important;
  }

  /* 11. Clase utilitaria: texto blanco en alto contraste
       (para textos que caen sobre elementos brightness(0)).
       Misma especificidad que la regla color:#000 (0,3,2)
       pero declarada después, así gana por orden. */
  :global(html.modo-alto-contraste:not(.modo-noche) .ac-blanco) {
    color: #FFFFFF !important;
  }

  /* Si además está activo modo noche: el invert(1) del wrapper
       convierte #000000 en blanco, así que usamos negro como
       origen para que invert lo deje blanco. */
  :global(html.modo-alto-contraste.modo-noche .ac-blanco) {
    color: #000000 !important;
  }

  /* ─── SOL ↔ LUNA toggle (modo noche) ─── */

  :global(.scene-wrapper img[src*="escenario-luna"]) {
    display: none !important;
  }

  :global(html.modo-noche .scene-wrapper img[src*="escenario-sol"]) {
    display: none !important;
  }

  :global(html.modo-noche .scene-wrapper img[src*="escenario-luna"]) {
    display: block !important;
  }

  /* ─── MODO NOCHE ───
       filter: invert(1) en scene-wrapper. Texto, UI y decorativos
       se invierten (texto claro, palmeras cambian de color).
       Excepciones con doble invert para que fondos, GIFs, logos
       y fotos de contenido mantengan colores naturales.

       REGLA: brightness() y saturate() van ANTES de invert()
       para oscurecer los colores originales y NO los invertidos. */
  :global(html.modo-noche) {
    background: #0a0718;
  }

  :global(html.modo-noche .scene-wrapper) {
    filter: invert(1) hue-rotate(180deg) !important;
  }

  /* Fondos — brightness → doble invert: oscuros, colores naturales */
  :global(html.modo-noche .scene-wrapper .fondos__img),
  :global(html.modo-noche .scene-wrapper .fondos__lqip) {
    filter: brightness(0.3) saturate(0.5) invert(1) hue-rotate(180deg) !important;
  }

  /* GIFs — brightness → doble invert: normales, ligeramente oscuros */
  :global(html.modo-noche .scene-wrapper img[src*="/gifs/"]) {
    filter: brightness(0.6) saturate(0.6) invert(1) hue-rotate(180deg) !important;
  }

  /* Decorativos (palmeras, cactus, letreros) — brightness hereda invert del wrapper */
  :global(html.modo-noche .scene-wrapper .escena__img) {
    filter: brightness(0.5) saturate(0.5) invert(1) hue-rotate(180deg) !important;
  }

  /* Logos y marcas de aliados — invert(0) para que solo reciban el invert
     del wrapper: en Aliados (sin .escena__img) se ven invertidos.
     El logo Lunaria de Portada (con .escena__img) NO coincide con este
     selector, así que toma la regla de .escena__img → doble invert → normal. */
  :global(html.modo-noche .scene-wrapper img[src*="/marcas/"]:not(.escena__img)) {
    filter: invert(0) hue-rotate(180deg) !important;
  }

  /* Logo Lunaria Portada (escena 0) — doble invert sin brightness, colores originales */
  :global(html.modo-noche .scene-wrapper img[src*="marca-lunaria"]) {
    filter: invert(1) hue-rotate(180deg) !important;
  }

  /* Content images — doble invert: normales */
  :global(html.modo-noche .scene-wrapper img) {
    filter: invert(1) hue-rotate(180deg) !important;
  }

  /* Videos, PDFs, documentos — doble invert: normales */
  :global(html.modo-noche .scene-wrapper iframe),
  :global(html.modo-noche .scene-wrapper embed),
  :global(html.modo-noche .scene-wrapper object) {
    filter: invert(1) hue-rotate(180deg) !important;
  }

  :global(html.modo-noche .acc-contenido) {
    filter: invert(1) hue-rotate(180deg) !important;
  }
  /* Contra-invert para textos que deben verse blancos en modo noche */
  :global(html.modo-noche .noche-claro) {
    filter: invert(1) hue-rotate(180deg) !important;
  }

  /* Contra-invert para botón volver — colores originales se restauran.
     Excluye variante círculo (SVG decorativo no debe contra-invertirse). */
  :global(html.modo-noche .boton-volver:not(.boton-volver--circulo)) {
    filter: invert(1) hue-rotate(180deg) !important;
  }

  /* Botón "Inicio" en Estrategias — fondo + texto (#DBAB40 / #161040) */
  :global(html.modo-noche .estrategias .boton-volver) {
    background-color: #DBAB40 !important;
    color: #161040 !important;
  }

  /* Botones "Investigación" en Laboratorio/Diplomado/ContraCorriente — solo color texto */
  :global(html.modo-noche .laboratorio .boton-volver),
  :global(html.modo-noche .diplomado .boton-volver),
  :global(html.modo-noche .contracorriente .boton-volver) {
    color: #161040 !important;
  }

  /* Badge "Podcast" en LosTrapos — mismos colores modo noche */
  :global(html.modo-noche .los-trapos__badge) {
    filter: invert(1) hue-rotate(180deg) !important;
    background-color: #DBAB40 !important;
    color: #161040 !important;
  }

  /* ─── REDUCIR MOVIMIENTO ─── */
  :global(html.modo-sin-movimiento *),
  :global(html.modo-sin-movimiento *::before),
  :global(html.modo-sin-movimiento *::after) {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  /* ─── TAMAÑO DE LETRA ─── */
  :global(html.letra-md) {
    font-size: 115% !important;
  }
  :global(html.letra-lg) {
    font-size: 135% !important;
  }
  :global(html.letra-xl) {
    font-size: 160% !important;
  }

  :global(html.letra-md .boton-volver__texto) {
    font-size: calc(var(--alto) * 3 / 100) !important;
  }
  :global(html.letra-lg .boton-volver__texto) {
    font-size: calc(var(--alto) * 3.5 / 100) !important;
  }
  :global(html.letra-xl .boton-volver__texto) {
    font-size: calc(var(--alto) * 4.2 / 100) !important;
  }
</style>
