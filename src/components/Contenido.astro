---
/**
 * ESCENA 2 · CONTENIDO
 *
 * Navegación con botones tipo píldora hacia subpáginas del informe.
 * Cada botón se posiciona con calc() relativo a --alto.
 */

interface Enlace {
  nombre: string;
  href: string;
  texto: string;
  top: number;
  left: number;
}

const ENLACES: Enlace[] = [
  { nombre: "Testimonios", href: "/testimonios", texto: "Testimonios", top: 24, left: 73 },
  { nombre: "Investigacion", href: "/investigacion", texto: "Investigación", top: 33, left: 85 },
  { nombre: "Talleres", href: "/talleres", texto: "Talleres", top: 54, left: 35 },
  {
    nombre: "Trapos",
    href: "/sacando-los-trapos",
    texto: "Sacando los trapos",
    top: 45.9,
    left: 58,
  },
  { nombre: "Estrategias", href: "/estrategias", texto: "Estrategias de acción", top: 57, left: 77 },
  { nombre: "Cuentas", href: "/cuentas-claras", texto: "Cuentas Claras", top: 66, left: 17 },
  { nombre: "Programas", href: "/programas", texto: "Programas", top: 75, left: 48 },
  {
    nombre: "Apoyan",
    href: "/aliados",
    texto: "¿Quiénes nos apoyan?",
    top: 75,
    left: 73,
  },
];
---

<nav class="contenido" aria-label="Navegación del informe">
  <div id="navegacion"></div>
  <h1 class="contenido__titulo ac-blanco" data-read>Contenido</h1>
  {
    ENLACES.map((e) => (
      <a
        class={`contenido__btn ${e.nombre}`}
        href={e.href}
        style={`top: calc(var(--alto) * ${e.top} / 100); left: ${e.left}%`}
        data-read
      >
        {e.texto}
      </a>
    ))
  }
</nav>

<style>

  #navegacion{
    position: relative;
    top: 5vw;
    width: 1vw;
    height: 1vw;

  }
  .contenido {
    position: absolute;
    width: 100%;
    height: calc(var(--alto) * 15 / 100);
    top: calc(var(--alto) * 4 / 100);
    z-index: 2;
  }

  .contenido__titulo {
    position: absolute;
    top: 8.5vw;
    left: 22%;
    transform: translateX(-50%);
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 4.5 / 100 * var(--zoom-letra, 1));
    font-weight: 700;
    color: var(--azul-noche);
    margin: 0;
  }

  .contenido__btn {
    position: absolute;
    text-decoration: none;
    background-color: var(--salmon);
    color: var(--azul-noche);
    padding: calc(var(--alto) * 1.1 / 100) calc(var(--alto) * 2.1 / 100);
    padding-left: calc(var(--alto) * 6 / 100);
    border-radius: var(--espacio-4xl);
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 2.1 / 100 * var(--zoom-letra, 1));
    font-weight: 700;
    transition: transform 0.2s ease;
    white-space: nowrap;
  }

  .contenido__btn:hover {
    transform: scale(1.05);
  }

  
  @media (max-width: 640px) {
    .contenido__btn{
          font-size: calc(var(--alto) * 4.1 / 100 * var(--zoom-letra, 1));
    }

    .Programas{
          top: calc(var(--alto) * 145 / 100) !important;
    }
    .Testimonios{
      top: calc(var(--alto) * 44 / 100) !important;
    left: 28% !important;
    }

    .Investigacion{
      top: calc(var(--alto) * 57 / 100) !important;
    left: 80% !important;
    }
    .Talleres{
      top: calc(var(--alto) * 90 / 100) !important;
    left: 20% !important;
    }

    .Trapos{
          top: calc(var(--alto) * 21.9 / 100) !important; 
    left: 73% !important;
    }

    .Estrategias {
          top: calc(var(--alto) * 98 / 100)   !important;
    left: 60% !important;
    }

    .Cuentas{
          top: calc(var(--alto) * 133 / 100) !important;
    left: 18% !important;
    }

    .Apoyan{
      top: calc(var(--alto) * 122 / 100 ) !important;
    left: 68% !important;
    }
  }
</style>
