---
/**
 * ESCENA 2 · CONTENIDO
 *
 * Navegación con botones tipo píldora hacia subpáginas del informe.
 * Cada botón se posiciona con calc() relativo a --alto.
 */

interface Enlace {
  href: string;
  texto: string;
  top: number;
  left: number;
}

const ENLACES: Enlace[] = [
  { href: "/testimonios", texto: "Testimonios", top: 8, left: 73 },
  { href: "/investigacion", texto: "Investigación", top: 11, left: 85 },
  { href: "/talleres", texto: "Talleres", top: 18, left: 35 },
  {
    href: "/sacando-los-trapos",
    texto: "Sacando los trapos",
    top: 15.3,
    left: 58,
  },
  { href: "/estrategias", texto: "Estrategias de acción", top: 19, left: 77 },
  { href: "/cuentas-claras", texto: "Cuentas Claras", top: 22, left: 17 },
  { href: "/programas", texto: "Programas", top: 25, left: 48 },
  {
    href: "/quienes-nos-apoyan",
    texto: "¿Quiénes nos apoyan?",
    top: 25,
    left: 73,
  },
];
---

<nav class="contenido" aria-label="Navegación del informe">
  {
    ENLACES.map((e) => (
      <a
        class="contenido__btn"
        href={e.href}
        style={`top: calc(var(--alto) * ${e.top} / 100); left: ${e.left}%`}
      >
        {e.texto}
      </a>
    ))
  }
</nav>

<style>
  .contenido {
    position: absolute;
    width: 100%;
    height: calc(var(--alto) * 5 / 100);
    top: calc(var(--alto) * 68 / 100);
    z-index: 2;
  }

  .contenido__btn {
    position: absolute;
    text-decoration: none;
    background-color: var(--salmon);
    color: var(--azul-noche);
    padding: 0.6vw 1.2vw;
    border-radius: var(--espacio-4xl);
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 0.7 / 100);
    font-weight: 700;
    transition: transform 0.2s ease;
    white-space: nowrap;
    padding-left: var(--espacio-3xl);
  }

  .contenido__btn:hover {
    transform: scale(1.05);
  }
</style>
