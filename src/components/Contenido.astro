---
/**
 * ESCENA 2 · CONTENIDO
 *
 * Navegación con botones tipo píldora hacia subpáginas del informe.
 * Cada botón se posiciona con calc() relativo a --alto.
 */

interface Enlace {
  href: string;
  texto: string;
  top: number;
  left: number;
}

const ENLACES: Enlace[] = [
  { href: "/testimonios", texto: "Testimonios", top: 24, left: 73 },
  { href: "/investigacion", texto: "Investigación", top: 33, left: 85 },
  { href: "/talleres", texto: "Talleres", top: 54, left: 35 },
  {
    href: "/sacando-los-trapos",
    texto: "Sacando los trapos",
    top: 45.9,
    left: 58,
  },
  { href: "/estrategias", texto: "Estrategias de acción", top: 57, left: 77 },
  { href: "/cuentas-claras", texto: "Cuentas Claras", top: 66, left: 17 },
  { href: "/programas", texto: "Programas", top: 75, left: 48 },
  {
    href: "/aliados",
    texto: "¿Quiénes nos apoyan?",
    top: 75,
    left: 73,
  },
];
---

<nav class="contenido" aria-label="Navegación del informe">
  <div id="navegacion"></div>
  <h1 class="contenido__titulo">Contenido</h1>
  {
    ENLACES.map((e) => (
      <a
        class="contenido__btn"
        href={e.href}
        style={`top: calc(var(--alto) * ${e.top} / 100); left: ${e.left}%`}
      >
        {e.texto}
      </a>
    ))
  }
</nav>

<style>

  #navegacion{
    position: relative;
    top: 5vw;
    width: 1vw;
    height: 1vw;

  }
  .contenido {
    position: absolute;
    width: 100%;
    height: calc(var(--alto) * 15 / 100);
    top: calc(var(--alto) * 4 / 100);
    z-index: 2;
  }

  .contenido__titulo {
    position: absolute;
    top: 8.5vw;
    left: 22%;
    transform: translateX(-50%);
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 4.5 / 100);
    font-weight: 700;
    color: var(--azul-noche);
    margin: 0;
  }

  .contenido__btn {
    position: absolute;
    text-decoration: none;
    background-color: var(--salmon);
    color: var(--azul-noche);
    padding: calc(var(--alto) * 1.1 / 100) calc(var(--alto) * 2.1 / 100);
    padding-left: calc(var(--alto) * 6 / 100);
    border-radius: var(--espacio-4xl);
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 2.1 / 100);
    font-weight: 700;
    transition: transform 0.2s ease;
    white-space: nowrap;
  }

  .contenido__btn:hover {
    transform: scale(1.05);
  }
</style>
