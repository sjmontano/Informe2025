---
/**
 * Fondos.astro — Fondo ilustrado de una escena
 *
 * Props:
 *   escena — índice de la escena (0 a 16)
 *
 * Capa de fondo con LQIP + transición. Solo renderiza el fondo
 * de la escena indicada. Debe estar dentro de un contenedor
 * con position: relative y height: var(--alto).
 */

import { readFileSync } from "node:fs";
import { join } from "node:path";

export interface Props {
  escena: number;
}

const { escena } = Astro.props;

const SECCIONES = [
  "Portada",
  "Carta",
  "Apoyamos",
  "Programas — Libertad y Democracia",
  "Programas — Autonomía y Sostenibilidad",
  "Fondo en Movimiento",
  "Investigación",
  "Diseño e ilustración",
  "Testimonios",
  "Cuentas Claras",
  "Territorios",
  "Detalle de programas",
  "Alianzas",
  "Investigación",
  "Proyección",
  "Agradecimientos",
  "Cierre",
] as const;

const BASE = join(process.cwd(), "public", "resources", "fondos");

const nro = String(escena + 1).padStart(2, "0");
let lqip = "";
try {
  const buf = readFileSync(join(BASE, `fondo-seccion-${nro}-lqip.webp`));
  lqip = `data:image/webp;base64,${buf.toString("base64")}`;
} catch {
  /* sin LQIP */
}

const fondo = {
  nro,
  seccion: SECCIONES[escena],
  src: `/resources/fondos/fondo-seccion-${nro}.webp`,
  srcSm: `/resources/fondos/fondo-seccion-${nro}-sm.webp`,
  lqip,
  alt: `${SECCIONES[escena]}, ilustración de Aquelarre Laboratorio de Diseño Feminista`,
  eager: escena === 0,
};
---

<div class="fondos" aria-hidden="true">
  {
    fondo.lqip && (
      <div
        class={`fondos__lqip  ${fondo.seccion}`}
        style={`background-image: url(${fondo.lqip})`}
      />
    )
  }
  <picture>
    
    <source  
          srcset={fondo.srcSm} media="(max-width: 640px)" />

          <img
      class="fondos__img"
      src={fondo.src}
      alt={fondo.alt}
      loading={fondo.eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={fondo.eager ? "high" : "auto"}
    />
  </picture>
</div>

<script>
  document.querySelectorAll(".fondos__img").forEach((el) => {
    if (!(el instanceof HTMLImageElement)) return;
    const img = el;
    const revelar = () => {
      img.style.opacity = "1";
      const lqip = img.closest(".fondos")?.querySelector(".fondos__lqip");
      if (lqip instanceof HTMLElement) lqip.style.opacity = "0";
    };
    if (img.complete && img.naturalWidth > 0) {
      revelar();
    } else {
      img.addEventListener("load", revelar, { once: true });
      img.addEventListener(
        "error",
        () => {
          img.style.opacity = "1";
        },
        { once: true },
      );
    }
  });
</script>

<style>
  .fondos {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .fondos picture {
    position: absolute;
    inset: 0;
  }

  .fondos__lqip {
    position: absolute;
    inset: -2%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(14px);
    z-index: 0;
    transition: opacity 0.3s ease;
  }

  .fondos__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    z-index: 1;
    transition: opacity 0.5s ease;
    will-change: opacity;

  }

  
   @media (max-width: 640px) {
    .Portada{
      background-image: url('/resources/fondos_responsive/inicio.webp') !important;
    }
   }
  
</style>
