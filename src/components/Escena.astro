      AGRADECIMIENTOS.map((e) =>
        esVideo(e.src) ? (
          <video
            class="escena__img"
            src={e.src}
            style={e.css + (e.z ? `; z-index: ${e.z}` : "")}
            autoplay
            loop
            muted
            playsinline
            aria-label={e.alt}
          />
        ) : (
          <img
            class="escena__img"
            src={e.src}
            alt={e.alt}
            style={e.css + (e.z ? `; z-index: ${e.z}` : "")}
            loading="lazy"
          />
        ),
      )
  }

  {
    enRango(16) &&
      ALIADOS.map((e) =>
        esVideo(e.src) ? (
          <video
            class="escena__img"
            src={e.src}
            style={e.css + (e.z ? `; z-index: ${e.z}` : "")}
            autoplay
            loop
            muted
            playsinline
            aria-label={e.alt}
          />
        ) : (
          <img
            class="escena__img"
            src={e.src}
            alt={e.alt}
            style={e.css + (e.z ? `; z-index: ${e.z}` : "")}
            loading="lazy"
          />
        ),
      )
  }
</div>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>(".escena video");
  if (videos.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play();
          } else {
            video.pause();
          }
        });
      },
      { rootMargin: "300px" },
    );

    videos.forEach((video) => observer.observe(video));
  }
</script>

<style>
  .escena {
    position: absolute;
    inset: 0;
    width: 100%;
    height: var(--alto);
    overflow: hidden;
    pointer-events: none;
  }

  .escena__img {
    position: absolute;
    object-fit: cover;
    user-select: none;
    z-index: 0;
  }
</style>
