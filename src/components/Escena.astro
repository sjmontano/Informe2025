const { escena, stagger = 0 } = Astro.props;
const elementos = ESCENAS[escena] || [];
---

<div class={`escena-wrapper fondo${escena}`}>
  <Fondos escena={escena > 16 ? 4 : escena} />

  <div class="escena-contenido">
    <div
      class={`escena${stagger > 0 ? "" : ""}`}
      aria-hidden="true"
      data-anim-stagger={stagger}
    >
      {
        elementos.map((e, i) => (
          <img
            style={css(e)}
            class={`escena__img${e.ocultarEnMovil ? " escena__img--ocultar-movil" : ""}  imagen_escena_${escena}_${i}`}
            src={e.src}
            alt={e.alt}
            loading={i === 0 && escena === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 && escena === 0 ? "high" : "auto"}
            decoding="async"
            data-anim-item={"anim" in e && e.anim ? "" : undefined}
          />
        ))
      }
    </div>

    <slot />
  </div>
</div>

