            autoplay
            loop
            muted
            playsinline
            preload="none"
            aria-label={e.alt}
          />
        ) : (
          <img
            class="escena__img"
            src={e.src}
            alt={e.alt}
            style={e.css + (e.z ? `; z-index: ${e.z}` : "")}
            loading={i === 0 ? "eager" : "lazy"}
