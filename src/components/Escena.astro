import { css } from "../utils/escena.js";
import Fondos from "./Fondos.astro";

// ─── Lógica ──────────────────────────────────────────────────────────

const { escena, stagger = 0 } = Astro.props;
const elementos = ESCENAS[escena] || [];
---

<div class="escena-wrapper">
  <Fondos escena={escena > 16 ? 4 : escena} />

  <div
    class={`escena${stagger > 0 ? " anim-entrada anim-entrada--fade" : ""}`}
    aria-hidden="true"
    data-anim-stagger={stagger}
  >
    {
      elementos.map((e, i) => (
        <img
          class="escena__img"
          src={e.src}
          alt={e.alt}
          style={css(e)}
          loading={i === 0 && escena === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 && escena === 0 ? "high" : "auto"}
          decoding="async"
          data-anim-item={"anim" in e && e.anim ? "" : undefined}
        />
      ))
    }
  </div>

  <slot />
</div>

<style>
  .escena-wrapper {
    position: relative;
    height: var(--alto);
    overflow: hidden;
  }

  .escena {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  .escena__img {
    position: absolute;
    object-fit: cover;
    user-select: none;
    z-index: 0;
  }
</style>
