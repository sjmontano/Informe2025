---
/**
 * ESCENA · CUENTAS CLARAS
 *
 * Visualización de ingresos y gastos 2025.
 */

import ProgressBar from "./ProgressBar.astro";

const dataIngresos = [
  {
    text: "SALDOS DE PROYECTOS A DIC-31-2024",
    value: "$ 10.165.693.195",
    percentage: 44.14,
  },
  {
    text: "DONANTES EUROPEOS",
    value: "$ 4.646.551.991",
    percentage: 20.18,
  },
  {
    text: "DONANTES NORTEAMERICANOS",
    value: "$ 6.330.098.770",
    percentage: 27.49,
  },
  {
    text: "FISCAL SPONSOR",
    value: "$ 542.160.000",
    percentage: 2.35,
  },
  {
    text: "OTROS",
    value: "$ 1.346.493.843",
    percentage: 5.85,
  },
  {
    text: "Total",
    value: "$ 23.030.997.799",
    percentage: 100,
  },
];

const dataGastos = [
  {
    text: "APOYO A ORGANIZACIONES",
    value: "$ 5.590.308.439",
    percentage: 56,
  },
  {
    text: "GASTOS PROGRAMÁTICOS",
    value: "$ 658.665.474",
    percentage: 7,
  },
  {
    text: "DESARROLLO INSTITUCIONAL",
    value: "$ 715.296.441",
    percentage: 7,
  },
  {
    text: "GASTOS ADMINISTRATIVOS",
    value: "$ 1.099.009.043",
    percentage: 11,
  },
  {
    text: "INVESTIGACIÓN",
    value: "$ 421.112.446",
    percentage: 4,
  },
  {
    text: "FISCAL SPONSOR",
    value: "$ 545.918.110",
    percentage: 6,
  },
  {
    text: "PROYECTOS REGIONALES LATINOAMERICANOS",
    value: "$ 894.102.717",
    percentage: 9,
  },
  {
    text: "Total",
    value: "$ 9.924.412.670",
    percentage: 100,
  },
];
---

<section class="cuentas anim-entrada anim-entrada--fade">
  <div class="cuentas__contenido">
    <div class="cuentas__columna">
      <span class="cuentas__subtitulo">
        En mareas cambiantes, cuentas claras:
      </span>

      <h2 class="cuentas__titulo">Ingresos 2025</h2>

      <ul class="cuentas__lista">
        {
          dataIngresos
            .filter((dato) => dato.text !== "Total")
            .map((dato) => (
              <li>
                <ProgressBar
                  percentage={dato.percentage}
                  text={dato.text}
                  value={dato.value}
                />
              </li>
            ))
        }

        <li class="cuentas__total">
          <span>{dataIngresos[dataIngresos.length - 1].text}</span>

          <span class="cuentas__valor">
            {dataIngresos[dataIngresos.length - 1].value}
          </span>
        </li>
      </ul>
    </div>

    <div class="cuentas__columna">
      <span class="cuentas__subtitulo">
        En mareas cambiantes, cuentas claras:
      </span>

      <h2 class="cuentas__titulo">Gastos 2025</h2>

      <ul class="cuentas__lista">
        {
          dataGastos
            .filter((dato) => dato.text !== "Total")
            .map((dato) => (
              <li>
                <ProgressBar
                  percentage={dato.percentage}
                  text={dato.text}
                  value={dato.value}
                />
              </li>
            ))
        }

        <li class="cuentas__total">
          <span>{dataGastos[dataGastos.length - 1].text}</span>

          <span class="cuentas__valor">
            {dataGastos[dataGastos.length - 1].value}
          </span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .cuentas {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .cuentas__contenido {
    position: absolute;
    top: 6vw;
    width: 100%;

    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 24vw;
  }

  .cuentas__columna {
    width: 30vw;
    margin-right: -3vw;
    display: flex;
    flex-direction: column;
  }

  .cuentas__subtitulo {
    font-family: var(--font-lato);
    font-size: 1vw;
    color: var(--azul-noche);
    margin-bottom: 1vw;
    margin:0vw;
  }

  .cuentas__titulo {
    font-family: var(--font-discordia);
    font-size: 2vw;
    font-weight: 700;
    color: var(--azul-noche);
    margin-top: 0vw;
    margin-bottom: 3vw;
  }

  .cuentas__lista {
    list-style: none;

    display: flex;
    flex-direction: column;
    gap: 0.5vw;

    padding: 0;
    margin: 0;
  }

  .cuentas__total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-discordia);
    font-size: 1.2vw;
    font-weight: 700;

    color: var(--blanco);
  }

  .cuentas__valor {
    text-align: right;
  }
</style>