---
/**
 * ESCENA 2 · ALTERNATIVAS
 *
 * Sección Alternativas, dentro de Estrategias de Acción.
 */
import BotonVolver from "./BotonVolver.astro";
---

<section
  class="alternativas"
  data-anim-stagger="200"
>
  <BotonVolver href="/estrategias" texto="Estrategias" top={3} right={6} z={3} />

  <h1 class="alternativas__titulo" data-anim-item data-read>Alternativas</h1>
</section>

<style>
  .alternativas {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .alternativas__titulo {
    position: absolute;
    top: calc(var(--alto) * 14 / 100);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-discordia);
    font-size: calc(var(--alto) * 5.4 / 100 * var(--zoom-letra, 1));
    font-weight: 700;
    color: var(--azul-noche);
    margin: 0;
  }
</style>
