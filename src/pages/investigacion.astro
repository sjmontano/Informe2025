---
/**
 * PÁGINA INVESTIGACIÓN — Escena 11
 *
 * Subpágina independiente con título, texto y enlaces a subsecciones.
 * Fondo: fondo-seccion-12
 */

import Escena from "../components/Escena.astro";
import Fondos from "../components/Fondos.astro";
import SeccionInvestigacion from "../components/Investigacion.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <style is:global>
    :root {
      --alto: calc(100vw * 0.5625 * 1);
    }
    html,
    body {
      overflow: hidden;
      height: 100%;
    }
    .scene-wrapper {
      min-height: auto;
      height: var(--alto);
    }
  </style>
  <Fondos desde={11} hasta={11} />
  <Escena desde={11} hasta={11} />
  <SeccionInvestigacion />
</Layout>
