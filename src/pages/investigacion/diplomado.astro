---
/**
 * PÁGINA DIPLOMADO 3.0 — Escena 13
 *
 * Subpágina para "Diplomado 3.0" dentro de Investigación.
 * Fondo: fondo-seccion-14
 */

import EscenaDiplomado from "../../components/Diplomado.astro";
import Escena from "../../components/Escena.astro";
import Fondos from "../../components/Fondos.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <style is:global>
    :root {
      --alto: calc(100vw * 0.5625 * 1);
    }
    html,
    body {
      overflow: hidden;
      height: 100%;
    }
    .scene-wrapper {
      min-height: auto;
      height: var(--alto);
    }
  </style>
  <Fondos desde={13} hasta={13} />
  <Escena desde={13} hasta={13} />
  <EscenaDiplomado />
</Layout>
