---
import BotonVolver from "../../components/BotonVolver.astro";
import Escena from "../../components/Escena.astro";
import CarruselEstrategia from "../../components/CarruselEstrategia.astro";
import Layout from "../../layouts/Layout.astro";

// Definición de las interfaces para las entradas del modal
interface ModalEntry {
  colectiva: string;
  proyecto: string;
  enlaceMedia: string;
  enlaceLunaria?: string;
  instagram: string;
}

interface ModalData {
  id: string;
  entradas: ModalEntry[];
  top:string;
}

const modales: ModalData[] = [
  {
    id: "Memorias",
    top: "calc(var(--alto) * 1.24 / 100)",
    entradas: [
      {
        colectiva: "Tayras",
        proyecto:
          "Semillero de Cuidado para la Vida: <br>Semilleros De Cuidado Para La Mujer Campesina",
        enlaceMedia: "https://youtu.be/ymgEugDjbZU?si=-TvcNOnvLSB35Rit",
        instagram: "@semillerosdecuidado",
      },
      {
        colectiva: "Las diosas en la frontera",
        proyecto:
          "PazA la Página: <br>La Tierra Ruge La Verdad",
        enlaceMedia:
         /* "https://drive.google.com/drive/folders/1rv78lfTBxrOxvd7BuR3nF40g3FK18VVg",*/
         
          "https://drive.google.com/file/d/1eE2KsttiAFdEMw6WRY0pX2JdVW2YkqTX/view",
        enlaceLunaria:
          "https://www.conexion.fondolunaria.org/forum/autonomia-derechos-y-sostenib/deconstruzine-un-fanzine-para-deconstruir-estereotipos-de-genero",
        instagram: "@pazalapagina",
      },
      {
        colectiva: "Luminti: Bekaura: hijas del maíz",
        proyecto:
          "Luminti: Bekaura:<br>hijas del maíz",
        enlaceMedia:
          /*"https://drive.google.com/drive/folders/1WPuThgh4YSdf0dSX1a8slAKiZSprzmQs?usp=sharing",*/
          
          "https://drive.google.com/file/d/1r4DXGs2uwUHVfNObdNzfORpSZKn0-dHB/view",
        enlaceLunaria:
          "https://www.conexion.fondolunaria.org/forum/autonomia-derechos-y-sostenib/fanzine-semilla-resultado-del-taller-de-fanzine-con-cuidadorxs-de-semillas-del-territorio",
        instagram: "@luminti_colectivo",
      },
      
    ],
  }
];

---

<Layout scroll={false}>
  <Escena escena={6}>
    <CarruselEstrategia modales={modales} />
    <BotonVolver  color="#161040" background="#DBAB40" texto="Estrategias de accion" 
    extraStyle="justify-self: center; margin-left: 66vh;"  variante="estrategia" top="15" z="20"
    href="/estrategias" />
  </Escena>
</Layout>
