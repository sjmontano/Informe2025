---
/**
 * PÁGINA TESTIMONIOS — Escena 8
 *
 * Subpágina independiente con carrusel de testimonios.
 */

import Escena from "../components/Escena.astro";
import Fondos from "../components/Fondos.astro";
import SeccionTestimonios from "../components/Testimonios.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <style is:global>
    :root {
      --alto: calc(100vw * 0.5625 * 1);
    }
    html, body { overflow: hidden; height: 100%; }
    .scene-wrapper { min-height: auto; height: var(--alto); }
  </style>
  <Fondos desde={10} hasta={10} />
  <Escena desde={10} hasta={10} />
  <SeccionTestimonios />
</Layout>
