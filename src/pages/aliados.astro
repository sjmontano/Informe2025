---
/**
 * PÁGINA ALIADOS — Escena 16
 *
 * Subpágina independiente con los logos de donantes y copartes.
 */

import SeccionAliados from "../components/Aliados.astro";
import Escena from "../components/Escena.astro";
import Fondos from "../components/Fondos.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <style is:global>
    :root {
      --alto: calc(100vw * 0.5625 * 1);
    }
    html, body { overflow: hidden; height: 100%; }
    .scene-wrapper { min-height: auto; height: var(--alto); }
  </style>
  <Fondos desde={16} hasta={16} />
  <Escena desde={16} hasta={16} />
  <SeccionAliados />
</Layout>
